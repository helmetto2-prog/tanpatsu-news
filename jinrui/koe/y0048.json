{
  "schema": 1,
  "year": 48,
  "title": "48年目　ヌクシオの年",
  "src": "y0048.mp3",
  "dur": 214.11,
  "hash": "f5529bdb0524b8f947c0b4d1",
  "made": "2026-11-27 00:53",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.77,
      "t": "48年目　ヌクシオの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.67,
      "e": 6.75,
      "t": "春・ヌクシオ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 7.35,
      "e": 13.13,
      "t": "ミル、見て。この海草の根に、青い小石がからまってる。とうちゃんの石と同じ色だ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 13.58,
      "e": 19.58,
      "t": "これ、きれい。みがいたら、もっと光るね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 20.03,
      "e": 23.51,
      "t": "水もぬるいんだ。春なのに、手を入れてもつめたくない。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 23.96,
      "e": 32.62,
      "t": "ぬるい潮だから、ヌクシオ。青い小石は、このヌクシオに乗って来たんだね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 33.07,
      "e": 41.73,
      "t": "ヌクシオは、南の風の三日あとに来る。とうちゃんのツキキザミにも、同じしるしがあるよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 42.18,
      "e": 45.55,
      "t": "なら、青い小石の浜は、南の海の向こうだ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 46.75,
      "e": 49.33,
      "t": "秋・カワネの炉ばた"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 49.93,
      "e": 55.99,
      "t": "ミル、聞いた？ とうちゃんは、大川の終わる所を見たくて、この村を出たんだって。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 56.44,
      "e": 61.57,
      "t": "海の白い粉を持って帰るって、言ったんだね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 62.02,
      "e": 67.86,
      "t": "だから、ナミノコを持ってきてよかった。とうちゃんの約束を、わたしたちが届けたよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 68.31,
      "e": 75.16,
      "t": "年寄りの人、なめて目をとじてた。それから笑ってた。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 75.61,
      "e": 80.81,
      "t": "年寄りの人の言葉、半分くらい分かった。ナエウタと同じ言い方だった。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 81.26,
      "e": 88.09,
      "t": "この赤い線のグツ、ほしそうに手をのばしてた。置いていこう。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 89.29,
      "e": 91.55,
      "t": "冬・せきの冬"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 92.15,
      "e": 97.78,
      "t": "コナ、ユゲグサのゆげを吸って。顔にかかるように、もっと近く！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 98.23,
      "e": 101.1,
      "t": "……ぼくは長老だ。寝てばかりはいられない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 101.55,
      "e": 104.99,
      "t": "とうちゃん、狩りはぼくが行く。ちゃんと告げてから行くよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 105.44,
      "e": 109.44,
      "t": "たきぎは、ぼくが集める。浜の流木も、丘の分も。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 109.89,
      "e": 116.34,
      "t": "ほらね、仕事はみんなが代わってくれる。せきの出る人は、治るまで炉のそば！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 116.79,
      "e": 119.57,
      "t": "……わかった。少しだけ、休む。"
    },
    {
      "k": "m",
      "a": 120.77,
      "e": 123.43,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 124.03,
      "e": 130.7,
      "t": "蓄え、九十かご。雨の年で、クリの実が少なかった。でも、冬は越せる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 131.15,
      "e": 138.52,
      "t": "せきの出た人は炉のそばで休んで、仕事はみんなで代わったよね。これからも、そうしたいな！"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 138.97,
      "e": 143.34,
      "t": "仕事を代わるのは、ぼくたちでできる。とうちゃんも、ちゃんと治った。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 143.79,
      "e": 150.86,
      "t": "カワネの年寄りたちは、とうちゃんの約束を覚えていた。来年は、年寄りたちがナカビまで来たいって。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 151.31,
      "e": 157.2,
      "t": "わたしの願いは、カワネの年寄りたちが、ナカビまで無事に来られますように、がいいな。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 157.65,
      "e": 166.92,
      "t": "赤い線のグツ、とても喜んでた。次は、ナワメのグツも持っていきたい。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 167.37,
      "e": 178.65,
      "t": "青い小石は、南の風のあとのヌクシオに乗って来る。いつか、ヌクシオの来る方へ、オオウルで行きたい。ぼくの願いは、ヌクシオの来る方の浜が見えますように、だ。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 179.1,
      "e": 189.34,
      "t": "でも、クロミネの峰が見えなくなる前に引き返す掟がある。まずはツキキザミに、ヌクシオの来る日をしるそう。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 189.79,
      "e": 213.11,
      "t": "……ごほん。では決める。せきの出る者は、治るまで炉のそばで休み、仕事はほかの者が代わる。ヌクシオの来る日は、ソヨとオキがツキキザミにしるす。オオウルで南へ出るかは、しるしがそろってから寄り合いで決める。天に届けるのは、カワネの年寄りたちがナカビまで無事に来られますようにという、クリの願いにする。"
    }
  ]
}