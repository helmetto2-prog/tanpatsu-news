  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 2.94,
      "t": "3年目　ハネギの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 3.84,
      "e": 5.95,
      "t": "夏・浮かぶ木"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 6.55,
      "e": 9.78,
      "t": "イソ！ 何してるの、そんな木に乗って。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 10.23,
      "e": 14.94,
      "t": "見て、沈まないんだ。中がうつろだから、ぼくが座っても浮いてる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 15.39,
      "e": 18.15,
      "t": "潮が満ちる。上がれ。今だ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 18.6,
      "e": 25.58,
      "t": "……うん。ねえ、母さん。この夏は、浜の小屋で寝てもいいかなあ。この木を見ていたいんだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 26.03,
      "e": 26.86,
      "t": "……一人でか。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 27.31,
      "e": 29.26,
      "t": "一人で。もう子どもじゃないよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 29.71,
      "e": 33.61,
      "t": "わたしは賛成。浜なら、イソはだれより強いもん。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 34.81,
      "e": 37.17,
      "t": "秋・ヨシのたのみ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 37.77,
      "e": 44.45,
      "t": "カシ、たのみがある。春に、はね返る木を見つけた。だが、わたしの力では曲がらない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 44.9,
      "e": 47.48,
      "t": "……近づかずに獣に届く物、か。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 47.93,
      "e": 55.66,
      "t": "たとえば、あの木を曲げて縄を張れば、棒を遠くへ飛ばせるかもしれない。小さく試したいが、一人ではできない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 56.11,
      "e": 61.78,
      "t": "口で言うだけではなかったんだな。行くぞ。ホムラに、まっすぐな木を探させる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 62.23,
      "e": 65.81,
      "t": "よかった。二人とも、森でけんかしないでよ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 67.01,
      "e": 69.63,
      "t": "秋・ハネギが鳴った"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 70.23,
      "e": 72.81,
      "t": "この木なら、節がなくてまっすぐだよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 73.26,
      "e": 76.4,
      "t": "おれが曲げる。ヨシ、縄を張れ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 76.85,
      "e": 79.27,
      "t": "張れた。棒をかけて……放す。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北きりたん",
      "a": 79.72,
      "e": 85.96,
      "t": "ビンって鳴った！ 棒が、流れの向こうまで飛んでった！ はね返る木だから、ハネギ！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 86.41,
      "e": 90.31,
      "t": "……だが、まだ獣には届かん。棒がまっすぐ飛ばない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 90.76,
      "e": 94.51,
      "t": "棒を選べばいい。冬のあいだに試そう。二人で。"
    },
    {
      "k": "m",
      "a": 95.71,
      "e": 98.36,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 98.96,
      "e": 109.45,
      "t": "数えた。秋にためたかごは、オオイシ四つ。冬に食べたのは、オオイシ三つと小石三つ。残りは小石七つ。去年よりはいい。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 109.9,
      "e": 117.18,
      "t": "春のはじめは、みんなやせたね。足りないときは、子どもの分を先に分けておくれ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 117.63,
      "e": 128.35,
      "t": "イソが浜の小屋に一人でいる。嵐の夜が心配だ。浜の小屋に一人でいるなら、毎朝たき火の煙を上げろ。煙が見えれば、丘から分かる。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 128.8,
      "e": 133.78,
      "t": "うん、上げるよ、毎朝。だから、次の夏も浜にいさせて。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 134.23,
      "e": 137.8,
      "t": "浜なら、イソはだれより強い。おれは止めん。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 138.25,
      "e": 143.71,
      "t": "ハネギは、棒がまっすぐ飛べば獣に届く。冬のあいだ、カシと棒を選ぶ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 144.16,
      "e": 148.23,
      "t": "棒の先にとがった石をつければ、もっと深く刺さるかもしれん。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 148.68,
      "e": 154.25,
      "t": "とがった石か。……石のことなら、わしにも考えがある。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 154.7,
      "e": 165.51,
      "t": "決める。浜の小屋に一人でいる者は、毎朝煙を上げる。イソは夏のあいだ浜を守る者、ハマモリじゃ。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 165.96,
      "e": 169.96,
      "t": "ハネギは、カシとヨシが二人で続けよ。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 170.41,
      "e": 175.17,
      "t": "願いは、大風にも飛ばされない、一年じゅう住める家がほしい。"
    },
    {
      "k": "ml",
      "j": 11,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 175.62,
      "e": 179.54,
      "t": "ぼくは、あの浮かぶ木で、入り江の向こうまで行ってみたいなあ。"
    },
    {
      "k": "ml",
      "j": 12,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 179.99,
      "e": 185.99,
      "t": "今年の願いは、ナギのにする。家は、みんなの物じゃ。"
    }
  ]
}