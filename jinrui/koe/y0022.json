  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.32,
      "t": "22年目　ワライヨの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.22,
      "e": 6.96,
      "t": "春・眠る所の花"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 7.56,
      "e": 13.11,
      "t": "見て。かあさんと、とうちゃんの眠る所に、白い花がいっぱい。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 13.56,
      "e": 17.13,
      "t": "シイばあが好きだった、ちいさい白い花だね！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 17.58,
      "e": 23.99,
      "t": "まあまあ、今夜は月が丸いよ。みんなでここに座って、二人の話をしようよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 24.44,
      "e": 32.17,
      "t": "おやじは石を割るたびに「昔はもっとうまかった」と言った。割りそこねた石は、だまって川へ投げていたぞ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 32.62,
      "e": 34.7,
      "t": "……トチじい、川に投げたの？"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 35.15,
      "e": 39.2,
      "t": "毎日だ。だから、川原にはおやじの石がヤマホドある。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 39.65,
      "e": 49.3,
      "t": "ほら、みんな笑ってる。かあさんも、とうちゃんも、きっと笑ってる。毎年、この月の夜に、ここで笑おうよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 7,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 49.75,
      "e": 52.03,
      "t": "笑う夜だから、ワライヨ！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 53.23,
      "e": 55.47,
      "t": "夏・イシイズミ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 56.07,
      "e": 61.5,
      "t": "坂の土が、雨のたびに湧き水へ落ちる。このままでは、また泥だらけだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 61.95,
      "e": 68.01,
      "t": "川原の平たい石を、まわりに立てて並べたら、土が止まる。ぼくが運ぶ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 68.46,
      "e": 75.35,
      "t": "たとえば、すき間に小石をつめれば、土は止まって、水だけが通ります。小さく試してみよう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 75.8,
      "e": 78.54,
      "t": "行くぞ。重い石は、おれが持つ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 78.99,
      "e": 84.85,
      "t": "見て、雨のあとなのに、すんでる！ 石で囲んだ泉だから、イシイズミだね！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 85.3,
      "e": 87.53,
      "t": "……コナ、おまえの並べ方がいい。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 88.73,
      "e": 91.27,
      "t": "秋・クリの木の下"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 91.87,
      "e": 96.55,
      "t": "ツル、オクノサワの葉、また取ってきた。手は包んだよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 97.0,
      "e": 105.77,
      "t": "ありがとう。……ねえ、コナ。わたし、コナが森の奥から帰ってくると、いちばんに顔を見たくなるの。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 106.22,
      "e": 110.86,
      "t": "ぼくも。ワライヨの夜、ツルの歌を聞いて、そう思った。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 111.31,
      "e": 116.32,
      "t": "同じだったんだね。……この気持ちには、まだ名前をつけないでおく。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 116.77,
      "e": 120.82,
      "t": "うん。かごは、ぼくが持つ。いっしょに帰ろう。"
    },
    {
      "k": "m",
      "a": 122.02,
      "e": 124.68,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 125.28,
      "e": 130.01,
      "t": "数えた。冬の終わりで、オオイシが二つと、小石が八つ残ってる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 130.46,
      "e": 133.6,
      "t": "実のよく落ちた年だった。春は楽に越せる。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 134.05,
      "e": 143.76,
      "t": "ワライヨを、毎年することにしようよ。春のはじめの丸い月の夜に、眠る所に集まって、歌って、思い出して笑うの。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 144.21,
      "e": 147.39,
      "t": "なんで、春のはじめの丸い月の夜なの？"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 147.84,
      "e": 152.95,
      "t": "花の咲いた夜だからさ。ツキキザミで数えておけば、その夜がいつか分かるよ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 153.4,
      "e": 164.7,
      "t": "ぼくは、湿地の草の種が、もっと見つかりますように、って願いたい。クリの実みたいに、まいたらまた生える草があれば、実の少ない年も困らない。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 165.15,
      "e": 169.24,
      "t": "ぼくは、トリシマの青い小石がどこから来たのか、知りたいなあ。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 169.69,
      "e": 184.12,
      "t": "決める。春のはじめの丸い月の夜は、眠る所に集まる。その夜は、イソがツキキザミで数えて知らせる。天に届けるのは、コナの、湿地の草の種がもっと見つかりますようにという願いにする。"
    }
  ]
}