{
  "schema": 1,
  "year": 25,
  "title": "25年目　ケムダナの年",
  "src": "y0025.mp3",
  "dur": 206.18,
  "hash": "1f0683251f9a3e66b3756600",
  "made": "2026-11-04 00:53",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.32,
      "t": "25年目　ケムダナの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.22,
      "e": 7.18,
      "t": "春・梁のすき間の魚"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 7.78,
      "e": 12.36,
      "t": "とうちゃん。これ、梁のすき間にはさまってた。秋の干し魚。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 12.81,
      "e": 16.45,
      "t": "茶色くかたまっているね。においは……くさっていない。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 16.9,
      "e": 22.15,
      "t": "ホシダナの魚は、冬のなかばで、においがした。これは、しない。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 22.6,
      "e": 26.33,
      "t": "炉の真上だ。冬じゅう、けむりにあたっていたんだね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 26.78,
      "e": 33.2,
      "t": "たとえば、よく乾かした魚を、わざと炉の上に置いてみたらどうだろう。小さく試してみよう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 33.65,
      "e": 35.5,
      "t": "やる。ぼくが番をする。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 36.7,
      "e": 39.47,
      "t": "夏・ナツが生まれた日"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 40.07,
      "e": 44.56,
      "t": "ツル、もう少しだよ。歌うから、いっしょに息をして。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 45.01,
      "e": 47.92,
      "t": "かあちゃん、手、はなさないで……。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 48.37,
      "e": 52.83,
      "t": "泣き声だ！ 男の子だって。ツル、男の子だよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 53.28,
      "e": 57.93,
      "t": "森が白いね。ナツユキの花の日に来た子だから、ナツ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 58.38,
      "e": 63.33,
      "t": "ナツ。いい名だねえ。シイばあにも、聞かせたかったよ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 64.53,
      "e": 67.28,
      "t": "秋・流れ着いたかい"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 67.88,
      "e": 72.9,
      "t": "ホムラ、見て。こぐための板だ。ぼくらのより、ずっと幅が広い。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 73.35,
      "e": 78.35,
      "t": "にぎる所が、つるつる。だれかが、何年も使った物だね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 78.8,
      "e": 82.42,
      "t": "南の風のあとに上がった。トオカゲの方から来たのかなあ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 82.87,
      "e": 89.52,
      "t": "……あなたがなんであんなに行きたいのか、少し分かった。この板を使ってた人の手を、見てみたくなる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 89.97,
      "e": 94.52,
      "t": "行くとしても、ソヨとオキが大きくなってからにする。寄り合いで話してから。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 94.97,
      "e": 98.57,
      "t": "うん。そのときは、わたしもいっしょに考える。"
    },
    {
      "k": "s",
      "s": 3,
      "a": 99.77,
      "e": 102.36,
      "t": "冬・ケムダナの前で"
    },
    {
      "k": "l",
      "s": 3,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 102.96,
      "e": 108.41,
      "t": "コイシ、ケムダナの魚を出せ。狩りに行く者に、力をつけさせる。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 108.86,
      "e": 111.68,
      "t": "まだ。これは、冬の終わりの分。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 112.13,
      "e": 115.09,
      "t": "ネムリアナにクリの実がある。けちけちするな。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 115.54,
      "e": 120.22,
      "t": "この前の冬も、そうやって開けて、冬の終わりに小石がなくなった。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 120.67,
      "e": 123.32,
      "t": "……おまえ、にぎった物を離さないな。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 5,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 123.77,
      "e": 128.29,
      "t": "コイシの小石は合っている。このままなら、冬の終わりまで足りる。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 6,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 128.74,
      "e": 131.71,
      "t": "分かった。冬の終わりまで、待つ。"
    },
    {
      "k": "m",
      "a": 132.91,
      "e": 135.56,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 136.16,
      "e": 144.45,
      "t": "数えた。冬の終わりでも、ネムリアナのクリの実と、ケムダナの魚が残った。ケムダナの魚は、くさっていない。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 144.9,
      "e": 150.28,
      "t": "ホシダナで乾かしてから、ケムダナでいぶす。これで、冬の終わりまでもつ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 150.73,
      "e": 156.75,
      "t": "ケムダナの魚は、冬の終わりまで残したい。ネムリアナとカチガイがからになってから開ける。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 157.2,
      "e": 162.16,
      "t": "おれは出せと言った。だが、コイシが正しかった。それでいい。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 162.61,
      "e": 170.15,
      "t": "ハナの浜で拾ったかいのことも話したい。南の風のあとに上がった。遠い陸の人も、舟をこいでいるんだと思う。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 170.6,
      "e": 176.27,
      "t": "行くかどうかは、まだ決めない。ソヨとオキが大きくなったら、寄り合いで話そう。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 176.72,
      "e": 185.48,
      "t": "ハジケマメは、去年よりたくさん実った。でも、豆はまだ小さい。ハジケマメが、もっと大きく実ればいいのに。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 185.93,
      "e": 191.14,
      "t": "ナツが大きくなるころには、ハジケマメがおなかいっぱい食べられるといいね。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 191.59,
      "e": 205.18,
      "t": "決める。ケムダナの魚は、ネムリアナとカチガイがからになってから開ける。かいは、浜の小屋に置いておく。天に届けるのは、コナの、ハジケマメが大きく実りますようにという願いにする。"
    }
  ]
}