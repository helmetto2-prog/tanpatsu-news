  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.55,
      "t": "26年目　マメエリの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.45,
      "e": 7.28,
      "t": "夏・川原の黒い物"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 7.88,
      "e": 17.05,
      "t": "ねえね、見て。川原の流木に引っかかってた。黒くて、つるつる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 17.5,
      "e": 21.17,
      "t": "細い歯がヤマホド並んでる！ 魚の骨みたいだね！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 21.62,
      "e": 26.83,
      "t": "髪にあててごらん。……ほら、すっと通る。髪をとかす物だね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 27.28,
      "e": 33.13,
      "t": "この黒、炉の火が映る。グツとはちがう光り方。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 33.58,
      "e": 39.51,
      "t": "カブレギの汁が乾いたときの色に似てる。コナの手が真っ黒になったときの色だよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 39.96,
      "e": 44.35,
      "t": "大川の上の方から流れてきたのかな。だれが作ったんだろうね！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 45.55,
      "e": 49.06,
      "t": "秋・大きい粒と小さい粒"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 49.66,
      "e": 53.38,
      "t": "大きい粒は、こっちのかご。春にまく分だ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 53.83,
      "e": 61.73,
      "t": "待って。不作の年だよ。大きい粒は、子どもたちに食べさせようよ。まくのは小さい粒でいいじゃない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 62.18,
      "e": 72.05,
      "t": "小さい粒をまいたら、また小さい豆しかならない。太いつるの豆は大きかった。大きい粒をまけば、また太いつるが出ると思う。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 72.5,
      "e": 75.44,
      "t": "そんなの、まいてみないと分からないじゃない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 75.89,
      "e": 80.46,
      "t": "かあちゃんも、コナも、ナツたちのことを考えてるんだよね……。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 80.91,
      "e": 84.76,
      "t": "……分かった。寄り合いで話す。みんなに決めてもらう。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 85.96,
      "e": 88.52,
      "t": "冬・炉のそばの縄"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 89.12,
      "e": 93.24,
      "t": "指は、こう。より目をそろえると、細くても切れない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 93.69,
      "e": 95.08,
      "t": "……また、ほどけた。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 95.53,
      "e": 103.99,
      "t": "わたしも、最初はそうだった。たとえば、つるを湧き水にひと晩ひたしてからなうと、手になじむ。小さく試してみよう。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 104.44,
      "e": 107.06,
      "t": "やる。……とうちゃん、手がふるえてる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 107.51,
      "e": 113.31,
      "t": "五十五だからね。だから今のうちに、縄のなき方を、きみの手に渡しておきたい。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 113.76,
      "e": 116.42,
      "t": "ぼくの手に、渡して。離さない。"
    },
    {
      "k": "m",
      "a": 117.62,
      "e": 120.27,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 120.87,
      "e": 127.91,
      "t": "数えた。不作で木の実は少なかったけど、ケムダナの魚とハジケマメがあって、冬の終わりまで足りる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 128.36,
      "e": 138.08,
      "t": "まく豆は、大きい粒から選んで残したい。大きい粒をまけば、大きい豆がなると思う。食べるのは、小さい粒から。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 138.53,
      "e": 149.08,
      "t": "まあまあ、わたしは大きい粒を子どもたちに食べさせたかったんだよ。でも、ナツが大きくなるころのことを考えたら、コナの言うとおりかもしれないね。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 149.53,
      "e": 157.88,
      "t": "たとえば、太いつるに印をつけておけば、次の秋に、どの粒から大きい豆がなったか分かる。小さく試してみよう。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 158.33,
      "e": 169.8,
      "t": "川原で拾った黒い物のことも話したい。歯がたくさんあって、髪がとかせる。つるつるに光っている。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 170.25,
      "e": 176.92,
      "t": "あの黒は、カブレギの汁が乾いた色に似てる。だれかが、汁を塗ったんだと思う。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 177.37,
      "e": 181.42,
      "t": "なんで、わざわざ塗るんだろう。光らせたかったのかな。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 181.87,
      "e": 189.11,
      "t": "あの黒い物のように、つるつるに光る物を、わたしも作ってみたい。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 189.56,
      "e": 202.11,
      "t": "決める。まく豆は、大きい粒から選んで残す。黒い物は、ミルが持っておく。天に届けるのは、ミルの、つるつるに光る物が作れますようにという願いにする。"
    }
  ]
}