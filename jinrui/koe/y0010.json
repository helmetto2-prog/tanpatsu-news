  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.02,
      "t": "10年目　ササリボの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 3.92,
      "e": 6.34,
      "t": "夏・浅瀬の岩"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 6.94,
      "e": 12.64,
      "t": "見て。あの子、せきをしてる。……袋の草は、あの子のためだったんだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 13.09,
      "e": 19.06,
      "t": "せきの子は、冷えるとつらいよ。ツル、のどの草の包みをおくれ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 19.51,
      "e": 23.38,
      "t": "これだね、シイばあ。わたしが岩に置いてくる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 23.83,
      "e": 27.94,
      "t": "先に手を出さない。置いて、下がる。それだけ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 28.39,
      "e": 33.53,
      "t": "……今、あの人が言いました。『ありがたい』と。川上の言葉です。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 33.98,
      "e": 37.02,
      "t": "ヨシおじ、分かるの？ なんで？"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 37.47,
      "e": 39.47,
      "t": "……冬になったら、話します。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 40.67,
      "e": 43.42,
      "t": "秋・黒い石の先"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 44.02,
      "e": 48.68,
      "t": "見て見て！ 黒い石、うすく割れた。とがった先ができた！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 49.13,
      "e": 51.91,
      "t": "川原に一人で何日もいたのは、これかあ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 52.36,
      "e": 54.31,
      "t": "貸せ。ハネギで放つぞ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 54.76,
      "e": 59.24,
      "t": "あっ、木にささった！ ささる棒だから……ササリボ！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 59.69,
      "e": 63.27,
      "t": "深い。これなら、獣に近づかなくても届く。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 63.72,
      "e": 67.01,
      "t": "じいちゃんの割り方で、ぼく一人で作ったんだ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 68.21,
      "e": 70.95,
      "t": "冬・炉のそばの話"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 71.55,
      "e": 77.98,
      "t": "わたしが川上の群れを出たのは、ひもじい冬でした。食べ物が、みんなの分ありませんでした。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 78.43,
      "e": 86.06,
      "t": "親のいないわたしが一人いなくなれば、そのぶん小さい子が食べられる。そう考えて、だれにも言わずに川を下りました。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 86.51,
      "e": 88.99,
      "t": "……それで、ずっと言えなかったんだね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 89.44,
      "e": 95.38,
      "t": "追い出されたのではありません。でも、逃げた者だと思われるのが、こわかったのです。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 95.83,
      "e": 99.97,
      "t": "逃げたやつが、あんな縄をなうか。ヨシはこの丘の者だ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 100.42,
      "e": 105.37,
      "t": "よく話してくれたね。今夜は、あったかくしてお休み。"
    },
    {
      "k": "m",
      "a": 106.57,
      "e": 109.22,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 109.82,
      "e": 116.5,
      "t": "川上の人は、こわくなかった。また会いたい。今度は、こっちからもおくり物を置こう。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 116.95,
      "e": 121.84,
      "t": "ササリボで、シカが遠くからとれた。黒い石が、もっとほしい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 122.29,
      "e": 129.99,
      "t": "置くなら、浅瀬の岩だけ。川は渡らない。置いたら下がる。それなら、どちらも近づきすぎない。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 130.44,
      "e": 137.28,
      "t": "わたしがいたころ、川上の人はグツを持っていませんでした。グツを置いたら、きっと喜ぶと思います。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 137.73,
      "e": 144.42,
      "t": "まあ、グツならいくつでもこねるよ。ツバメツチでね。春になったら、一つ焼こうよ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 144.87,
      "e": 150.74,
      "t": "ぼくも、黒い石がもっとほしい。ササリボの先を、みんなの分作りたい。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 151.19,
      "e": 158.08,
      "t": "わたしは、あのせきの子が、よくなってほしい。シイばあの草、ちゃんと効いたかなあ。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 158.53,
      "e": 173.46,
      "t": "決めるよ。川上の人へのおくり物は、ナギの言うとおり、浅瀬の岩に置いて下がる。川を渡って会いに行くのは、まだしない。春には、アケビのグツを一つ置こう。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 173.91,
      "e": 182.85,
      "t": "天に届けるのは、ツルの願いにしよう。川向こうの子のことは、わたしたちには確かめられないからね。"
    }
  ]
}