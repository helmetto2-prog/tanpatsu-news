{
  "schema": 1,
  "year": 43,
  "title": "43年目　ウツシギとオオウルの年",
  "src": "y0043.mp3",
  "dur": 183.54,
  "hash": "f3626aeeb717b4cf2ffda255",
  "made": "2026-11-22 00:48",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 4.36,
      "t": "43年目　ウツシギとオオウルの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 5.26,
      "e": 7.88,
      "t": "春・日なたへ移す芽"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 8.48,
      "e": 13.6,
      "t": "とうちゃん、見て！ 日の当たる所の芽は太いのに、日かげの芽はひょろひょろだよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 14.05,
      "e": 20.74,
      "t": "見て見て、根の土ごと掘れば、芽は切れない。日の当たる所へ、移せばいいんだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 21.19,
      "e": 27.38,
      "t": "青い羽の鳥が、実を埋めてたんだね！ 実を埋める鳥だから、ウメドリだね！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 27.83,
      "e": 32.56,
      "t": "鳥が埋めて、ぼくらが移す。木を移すから、ウツシギだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 33.01,
      "e": 36.74,
      "t": "ぼくもやる。日なたの坂いっぱいに、クリの木をならべたい。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 37.94,
      "e": 41.0,
      "t": "夏・南の坂のホリヤ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 41.6,
      "e": 47.24,
      "t": "かあさん、芽がシカにかじられてた。ぼくが南の坂にホリヤを建てて、夜も番をする。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 47.69,
      "e": 52.04,
      "t": "ひとりで？ 夜の坂は暗いし、獣も来るよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 52.49,
      "e": 56.93,
      "t": "ワタリが来てくれる。火も絶やさない。出かけるときは、ちゃんと告げる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 57.38,
      "e": 64.05,
      "t": "ぼくも十八のころは、早くひとりで何かをしたかった。柱の穴は、いっしょに掘ろう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 64.5,
      "e": 70.89,
      "t": "……わかった。でも、毎朝けむりを上げてね。それを見たら、安心するから。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 71.34,
      "e": 73.75,
      "t": "うん。毎朝、けむりを上げる。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 74.95,
      "e": 77.86,
      "t": "秋・オオウルが浮かんだ日"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 78.46,
      "e": 82.09,
      "t": "浮かんだなあ……。五人乗っても、水が入ってこないよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 82.54,
      "e": 88.62,
      "t": "潮は静か。風もない。とうちゃん、まっすぐ進んでる！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 89.07,
      "e": 91.15,
      "t": "このまま、トリシマまで行ける？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 91.6,
      "e": 98.39,
      "t": "きょうは入り江までにする。なんでかというと、オオウルはまだ一度も、外の海で試していないから。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 98.84,
      "e": 104.83,
      "t": "うん、ホムラの言うとおりだなあ。来年の夏、潮のいい日に、トリシマで試そう。"
    },
    {
      "k": "m",
      "a": 106.03,
      "e": 108.68,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 109.28,
      "e": 117.07,
      "t": "南の坂に移した芽は、十のうち八つが、雪の前まで青い葉をつけてた。シカは、ワタリがほえて追いはらってくれた。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 117.52,
      "e": 125.71,
      "t": "ウツシギは、うまくいく。来年の春も、日かげの芽を日なたへ移したい。ナツが番をしてくれれば安心だ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 126.16,
      "e": 130.03,
      "t": "蓄え、七十九かご。二年、余り。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 130.48,
      "e": 134.87,
      "t": "オオウルは浮かんだ。来年の夏、トリシマまで行ってみたいんだよなあ。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 135.32,
      "e": 143.79,
      "t": "トオカゲへ出す前に、トリシマまで三度は渡って、オオウルの重さと、潮のくせを覚えたい。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 144.24,
      "e": 145.29,
      "t": "なんで三度？"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 145.74,
      "e": 157.79,
      "t": "一度目は静かな日、二度目は少し風のある日、三度目は帰りの潮が速い日。三つの海を知ってから、遠くを考えたい。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 158.24,
      "e": 164.41,
      "t": "天への願いは、オオウルでトオカゲまで行って、みんな無事に帰ってこられますように、がいいなあ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 164.86,
      "e": 182.54,
      "t": "では決める。オオウルは、トリシマまで三度渡ってから、遠くへ出すかを寄り合いで決める。南の坂の芽はナツが番をして、春はみんなでウツシギをする。天に届けるのは、オオウルでトオカゲまで行って無事に帰ってこられますようにという、イソの願いにする。"
    }
  ]
}