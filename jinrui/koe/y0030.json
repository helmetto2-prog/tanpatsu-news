  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.43,
      "t": "30年目　ナミノコの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.33,
      "e": 7.56,
      "t": "夏・グツの底の白い粉"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 8.16,
      "e": 13.36,
      "t": "とうちゃん、見て！ グツの底が、白くなってきた！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 13.81,
      "e": 17.02,
      "t": "シロクボと同じかなあ。……うん、しょっぱい。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 17.47,
      "e": 23.07,
      "t": "波が置いていった子みたい。この白い粉は、ナミノコって呼ぶ！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 23.52,
      "e": 26.84,
      "t": "ねえね、流木、もうない。ぜんぶ燃えた。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 27.29,
      "e": 32.89,
      "t": "グツ一つで、これだけかあ。海の水はいくらでもあるけど、たきぎが足りないなあ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 33.34,
      "e": 39.9,
      "t": "じゃあ、ナミノコは少しずつ大事に使う。ナギばあの母さんみたいに。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 41.1,
      "e": 43.51,
      "t": "秋・ハナの岩場"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 44.11,
      "e": 46.21,
      "t": "ねえね、待って！ ……いたっ！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 46.66,
      "e": 51.43,
      "t": "オキ！ 足の裏、切れてる。動かないで。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 51.88,
      "e": 55.6,
      "t": "走ったら、貝がらがあった。……ひ、ひとりで歩ける。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 56.05,
      "e": 59.05,
      "t": "だめ。わたしの背中にのって。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 59.5,
      "e": 66.05,
      "t": "なんで岩場で走ったの？ ……いや、走りたくなる気持ちは、わたしがいちばん知ってるか。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 66.5,
      "e": 68.57,
      "t": "ソヨ、よく背負ってきたね。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 69.77,
      "e": 72.2,
      "t": "冬・コイシのホリヤ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 72.8,
      "e": 77.18,
      "t": "とうちゃん。ぼく、自分のホリヤ、作る。ホエと寝る。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 77.63,
      "e": 82.3,
      "t": "一人で暮らすのかい。たとえば、柱をしばる縄は、どうする？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 82.75,
      "e": 85.64,
      "t": "柱の縄は、ぜんぶ、ぼくがなう。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 86.09,
      "e": 90.19,
      "t": "柱はそこだ。もう少し右。……おれは杖で指すだけだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 90.64,
      "e": 95.3,
      "t": "結び目が、ほどけないね。わたしの縄より、固いかもしれない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 95.75,
      "e": 96.38,
      "t": "……やった。"
    },
    {
      "k": "m",
      "a": 97.58,
      "e": 100.24,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 100.84,
      "e": 104.94,
      "t": "数えた。小石が残る。冬の終わりまで、足りる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 105.39,
      "e": 112.56,
      "t": "ナミノコは、グツ一つ煮て、手のひらに少しだけ。たきぎがたくさん要る。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 113.01,
      "e": 120.5,
      "t": "まあまあ、ほんの少しでも、干し魚がおいしくなるならうれしいよ。たきぎは、みんなで拾おうよ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 120.95,
      "e": 126.14,
      "t": "ハナの岩場は、潮が引くと貝がらだらけだ。岩場では走らないことにしようかなあ。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 126.59,
      "e": 131.25,
      "t": "なんで？ 走らないと、潮が満ちる前に戻れないこともあるよ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 131.7,
      "e": 137.12,
      "t": "潮は、ぼくとソヨが読む。満ちる前に戻る時を言えば、走らなくていいかなあ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 137.57,
      "e": 141.79,
      "t": "……それなら分かった。オキのけがを見たら、わたしもそう思う。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 142.24,
      "e": 146.99,
      "t": "ぼくは、岩場の貝がらで足を切らないですむ物がほしい。天に頼みたい。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 147.44,
      "e": 162.51,
      "t": "みんな、ありがとう。では決める。ハナの岩場では走らない。ナミノコは、夏に少しずつ煮て、大事に使う。天に届けるのは、岩場の貝がらで足を切らないですむ物が見つかるようにという、オキの願いにする。"
    }
  ]
}