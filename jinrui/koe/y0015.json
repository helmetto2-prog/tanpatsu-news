  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.2,
      "t": "15年目　クロミネの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.1,
      "e": 7.4,
      "t": "春・岩の上の小さな山"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 8.0,
      "e": 13.89,
      "t": "あの人は、朝に光った峰を指さしました。黒い石は、あそこで取れるそうです。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 14.34,
      "e": 19.45,
      "t": "見て見て！ 小石を山の形に積んで、てっぺんに黒い石をのせてる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 19.9,
      "e": 26.87,
      "t": "川上の人々の土地を、ずっと上がった先だと言っていました。歩くと、いくつもの夜がかかるそうです。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 27.32,
      "e": 32.88,
      "t": "……遠いんだ。でも、どこか分かった。それだけで、胸がどきどきする。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "ずんだもん",
      "a": 33.33,
      "e": 36.27,
      "t": "黒い石の峰だから、クロミネだね！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 36.72,
      "e": 39.98,
      "t": "クロミネ。じいちゃんにも、見せたかったな。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 41.18,
      "e": 43.37,
      "t": "夏・赤い手"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 43.97,
      "e": 47.93,
      "t": "コナ、また手が赤い！ カブレギにさわったでしょ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 48.38,
      "e": 52.68,
      "t": "火の番のアケビおばさんに言ってから行ったよ。掟は守った。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 53.13,
      "e": 59.09,
      "t": "掟の話じゃないの。手の話！ まず手を治すって、言ったよね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 59.54,
      "e": 65.75,
      "t": "でも、汁を少しだけグツに取ってこられた。乾くと黒くて固いんだ。ぼくがやる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 66.2,
      "e": 70.64,
      "t": "その手に、またユゲグサを煮るのは、わたしなんだよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 71.09,
      "e": 71.93,
      "t": "……頼んでない。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 73.13,
      "e": 75.63,
      "t": "秋・抜けない先"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 76.23,
      "e": 79.29,
      "t": "見ろ。シカに当たっても、先が取れてない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 79.74,
      "e": 84.48,
      "t": "ほんとだ。いつもなら、先だけ抜けて、どこかへ行っちゃうのに。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 84.93,
      "e": 90.62,
      "t": "カブレギの汁で、しばった所を固めたんだ。乾くと、石みたいになる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 91.07,
      "e": 91.85,
      "t": "……いい先だ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 92.3,
      "e": 92.74,
      "t": "……うん。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 93.19,
      "e": 96.67,
      "t": "父さん、それだけ？ もっと言ってあげなよ。"
    },
    {
      "k": "m",
      "a": 97.87,
      "e": 100.53,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 101.13,
      "e": 106.68,
      "t": "春のはじめ、蓄えは五かごしかなかった。根と貝で、やっとしのいだ。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 107.13,
      "e": 111.6,
      "t": "子どもたちが春に少しやせたのが、気がかりだったよ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 112.05,
      "e": 118.09,
      "t": "クロミネへ、いつか行きたい。でも、川上の人々の土地をこえるんだよね。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 118.54,
      "e": 126.49,
      "t": "歩いて、いくつもの夜がかかります。たとえば、もっと言葉が通じるようになってからでも、遅くはないと思います。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 126.94,
      "e": 133.36,
      "t": "コナのシルヅケのササリボは、シカに当たっても先が取れん。狩りに出る者の分を、作ってくれ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 133.81,
      "e": 137.35,
      "t": "作る。でも、カブレギの汁がもっと要る。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 137.8,
      "e": 147.6,
      "t": "なら、汁を取るときは、手を大きな葉と皮で包んで。取ったら、すぐ沢の水で手を洗うの。それを掟にしてほしい。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 148.05,
      "e": 155.06,
      "t": "まあまあ。ツルもコナも、言ってることは同じだよ。手を包む皮なら、わたしが縫おうか。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 155.51,
      "e": 157.42,
      "t": "……分かった。包んで行く。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 157.87,
      "e": 164.42,
      "t": "願いは、春のはじめのことにしたい。蓄えの少ないころにも、食べる物がありますように。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 164.87,
      "e": 180.28,
      "t": "決めるよ。カブレギの汁は、手を包んで取ること。コナは、狩りに出る者のササリボをシルヅケでとめておくれ。クロミネへは、まだ行かない。願いは、ナギのにしよう。"
    }
  ]
}