{
  "schema": 1,
  "year": 40,
  "title": "40年目　ナガナミと赤い縄の年",
  "src": "y0040.mp3",
  "dur": 221.2,
  "hash": "34ff8f121ef2d2e7d1a5892e",
  "made": "2026-11-19 00:49",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 4.36,
      "t": "40年目　ナガナミと赤い縄の年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 5.26,
      "e": 8.62,
      "t": "春・風のない朝の長い波"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 9.22,
      "e": 15.59,
      "t": "とうちゃん、見て。風がないのに、長い波がゆっくり寄せてくる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 16.04,
      "e": 21.64,
      "t": "海鳥も沖へ出ないで、丘の上をまわってるなあ。こんな朝は、はじめてかなあ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 22.09,
      "e": 27.97,
      "t": "ねえね、ツキキザミの流木に小石を置いておこう。何夜目に風が来るか、数えられる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 28.42,
      "e": 35.52,
      "t": "うん。三つ目の夜……来た！ ウルは、もう丘のふもとにしばってある。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 35.97,
      "e": 39.61,
      "t": "ソヨの目は、ナギかあさんより先を見てるのかもしれないなあ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 40.06,
      "e": 47.87,
      "t": "この長い波を、ナガナミって呼ぶね。ナガナミが来たら、三日のうちに大風が来る。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 49.07,
      "e": 51.98,
      "t": "秋・割れた大きなグツ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 52.58,
      "e": 57.6,
      "t": "あらあら、ぴしりといったねえ。大きいグツは、火がこわいんだよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 58.05,
      "e": 64.18,
      "t": "かあさん、ナワメもつけたのに、どうして割れたんだろう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 64.63,
      "e": 73.56,
      "t": "まあまあ。わたしの手じゃ、もう大きいグツの土を、むらなくこねきれないのさ。次の大きいグツは、ミルが焼いておくれ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 74.01,
      "e": 78.31,
      "t": "ぼくも手伝う。ナワメの縄を転がすのは、ぼく、うまいよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 78.76,
      "e": 85.55,
      "t": "そうだったねえ。二人で焼いたら、みんなのクリの実をいっぺんに煮られる。ああ、楽しみだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 86.0,
      "e": 94.2,
      "t": "うん、きっと割らずに焼く。かあさんに、いちばんに食べてもらうから。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 95.4,
      "e": 98.06,
      "t": "冬・赤い細い縄"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 98.66,
      "e": 103.65,
      "t": "コイシにいさんのホリヤに、赤い細い縄があったよ。あれ、だれの縄？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 104.1,
      "e": 110.24,
      "t": "ナツ、それは……言わないって約束だったのに。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 110.69,
      "e": 111.24,
      "t": "……ばれた。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 111.69,
      "e": 116.33,
      "t": "赤い縄？ ミルねえのアカヤキで、そめたの？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 116.78,
      "e": 121.79,
      "t": "ソヨの縄。大風の前、ソヨが知らせた。だから、やる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 122.24,
      "e": 127.18,
      "t": "アカヤキをすりこんでよった縄だから、アカヨリだね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 6,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 127.63,
      "e": 133.57,
      "t": "……ずっと、だまってなってたの？ ありがとう。手首に結んで。"
    },
    {
      "k": "m",
      "a": 134.77,
      "e": 137.43,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 138.03,
      "e": 147.13,
      "t": "アケビかあさんのいない冬は、はじめてだね。でも、決めなくちゃ。次の長老は、ホムラねえがいいと思う。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 147.58,
      "e": 152.51,
      "t": "ホムラは、わけが分かるまで動かない。だから、まちがいが少ないかなあ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 152.96,
      "e": 161.9,
      "t": "なんでわたし？ ……そう。みんながうなずくなら、引き受ける。でも、わけは毎回、みんなに言ってもらうからね。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 162.35,
      "e": 165.89,
      "t": "ぼくはうなずく。見て、みんなもうなずいてる。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 166.34,
      "e": 177.87,
      "t": "ナガナミが来たら、見た者はその日のうちに、丘の火の番とみんなに知らせることにしたい。そうすれば、クリの実を先に拾える。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 178.32,
      "e": 184.52,
      "t": "なんでその日のうちに？ ……そうか、三日しかないからだね。わたしもそれがいいと思う。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 184.97,
      "e": 188.3,
      "t": "夏のせきは、ユゲグサでみんな治ったよ。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 188.75,
      "e": 200.28,
      "t": "かあさんの大きなグツは、焼くときに割れた。大きなグツが割れずに焼けたら、みんなのクリの実をいっぺんに煮られる。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 200.73,
      "e": 204.71,
      "t": "ぼくは、ウミガメの泳いでいった海の向こうを、いつか見てみたい。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 205.16,
      "e": 220.2,
      "t": "では決める。次の長老は、みんながうなずいたので、わたしが引き受ける。ナガナミを見たら、その日のうちにみんなに知らせる。天に届けるのは、大きなグツが割れずに焼けますようにという、ミルの願いにする。"
    }
  ]
}