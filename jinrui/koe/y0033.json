  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.63,
      "t": "33年目　カラミズの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.53,
      "e": 7.33,
      "t": "春・ホシモの白い粉"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 7.93,
      "e": 13.95,
      "t": "オキ、見て。ホシモに白い粉がふいてる。なめてみて。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 14.4,
      "e": 16.46,
      "t": "しょっぱい！ ナミノコと同じだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 16.91,
      "e": 23.24,
      "t": "海の水を、ホシモに何度もかけてみよう。夢で、そうしてたの。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 23.69,
      "e": 26.31,
      "t": "ぼくが海の水をくんでくる。何度でも。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 26.76,
      "e": 29.43,
      "t": "……したたる水、なめてみて。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 29.88,
      "e": 32.41,
      "t": "からい！ 海の水より、ずっと。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 32.86,
      "e": 39.84,
      "t": "からい水……カラミズって呼ぼう。これなら、たきぎが少しですむかも！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 41.04,
      "e": 43.68,
      "t": "夏・たきぎの言い合い"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 44.28,
      "e": 48.35,
      "t": "それ、丘のたきぎ。ぼくが数えてる。冬の分。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 48.8,
      "e": 53.96,
      "t": "カラミズなら、前の半分ですむの。少しだけだよ！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 54.41,
      "e": 57.39,
      "t": "少しでも、減る。もう運ばないで。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 57.84,
      "e": 63.12,
      "t": "コイシのけち！ ナミノコがあれば、魚がくさらないのに！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 63.57,
      "e": 68.19,
      "t": "まって。なんで二人とも怒ってるの？ わけを一つずつ言って。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 68.64,
      "e": 71.76,
      "t": "……冬に、たきぎが足りないと、みんな寒い。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 72.21,
      "e": 76.41,
      "t": "……ナミノコがないと、魚を長くとっておけない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 7,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 76.86,
      "e": 83.27,
      "t": "どっちも村のためだね。じゃあ、丘のたきぎのほかに、燃やす物を探せばいい。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 84.47,
      "e": 87.02,
      "t": "夏・大漁の浜"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 87.62,
      "e": 92.09,
      "t": "群れが入ってきたなあ。掟のとおり、食べる分より多く干そう。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 92.54,
      "e": 98.23,
      "t": "ナミノコをすりこんでから干すね。オキの流木で煮たナミノコだよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 98.68,
      "e": 100.61,
      "t": "……流木だけで、煮たの？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 101.06,
      "e": 105.32,
      "t": "うん。丘のたきぎは、一本も使ってない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 105.77,
      "e": 109.72,
      "t": "……なら、いい。流木の山、ぼくも数える。"
    },
    {
      "k": "m",
      "a": 110.92,
      "e": 113.58,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 114.18,
      "e": 118.14,
      "t": "数えた。小石が残る。干し魚が多い年だった。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 118.59,
      "e": 123.94,
      "t": "ナミノコを煮るのは、浜の流木だけにして。丘のたきぎは、冬の分。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 124.39,
      "e": 133.24,
      "t": "カラミズなら、たきぎは少しでいいの。オキが流木を集めてくれるから、流木だけで煮るよ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 133.69,
      "e": 141.31,
      "t": "なんで流木だけなの？ ……そうか、丘のたきぎが減ると、冬にみんなが寒いからだね。わかった。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 141.76,
      "e": 159.08,
      "t": "ねえ、見て。ハネギの黒い光、きれいでしょう。赤い色も塗れたら、もっときれい。塗れる赤い色が見つかるように、天にお願いしたい。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 159.53,
      "e": 162.98,
      "t": "ぼくは、ねえねみたいに潮を読めるように、願いたい。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 163.43,
      "e": 180.39,
      "t": "まあまあ、みんなありがとう。では決める。ナミノコを煮るたきぎは、浜の流木だけにする。天に届けるのは、塗れる赤い色が見つかるようにという、ミルの願いにする。オキの潮読みは、ソヨが教えてあげようよ。"
    }
  ]
}