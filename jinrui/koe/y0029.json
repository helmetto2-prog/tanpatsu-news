  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.7,
      "t": "29年目　ナカワシの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.6,
      "e": 6.94,
      "t": "春・浅瀬の岩"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 7.54,
      "e": 12.32,
      "t": "見て、とうちゃん。小石を見せたら、向こうの人も小石を拾ったよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 12.77,
      "e": 18.73,
      "t": "向こうでは、小石を『ツブ』と呼ぶらしい。たとえば、水も聞いてみよう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 19.18,
      "e": 23.45,
      "t": "ミズ！ ……ほら、向こうの人も川を指さして、何か言った！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 23.9,
      "e": 29.67,
      "t": "うん。一つ言ったら、一つ返ってくる。小さく試して、少しずつ増やそう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 30.12,
      "e": 35.45,
      "t": "じゃあ、いちばん聞きたいことを聞くね。……わたしは、クリ。クリだよ！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 35.9,
      "e": 39.75,
      "t": "胸に手を当てている。あれは、名を言う前のしぐさだ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 40.95,
      "e": 43.35,
      "t": "夏・白いくぼみ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 43.95,
      "e": 48.68,
      "t": "とうちゃん、見て！ 岩のくぼみが、白い！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 49.13,
      "e": 51.13,
      "t": "なめてごらん。……しょっぱいかなあ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 51.58,
      "e": 55.88,
      "t": "しょっぱい！ 海の水が、白くなったの？"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 56.33,
      "e": 60.77,
      "t": "潮が引いて、日が照った。水だけが、空へ行った。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 61.22,
      "e": 63.79,
      "t": "ここ、シロクボって呼ぶ！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 64.24,
      "e": 70.62,
      "t": "……わたしの生まれた浜にも、こういう所があった。母は、この白い物を大事にしていた。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 71.82,
      "e": 74.66,
      "t": "秋・炉のそばの小石"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 75.26,
      "e": 78.63,
      "t": "コイシ。この小石は、もうおまえの物だ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 79.08,
      "e": 81.35,
      "t": "……ぼくの。数える。ずっと。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 81.8,
      "e": 86.51,
      "t": "カシ。潮が引くときは、静かに引く。せかせかするな。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 86.96,
      "e": 89.21,
      "t": "……おまえの言うことは、いつも当たる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 89.66,
      "e": 94.54,
      "t": "イソには潮を、コイシには数えを渡した。もう、足りている。"
    },
    {
      "k": "m",
      "a": 95.74,
      "e": 98.39,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 98.99,
      "e": 103.4,
      "t": "数えた。ナギおばの小石で。冬の終わりまで、足りる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 103.85,
      "e": 108.78,
      "t": "ナギがいない。次の長老を決めるぞ。……おれは、ヨシがいいと思う。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 109.23,
      "e": 111.98,
      "t": "なんでヨシなの？ とうちゃんじゃなくて？"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 112.43,
      "e": 119.97,
      "t": "おれは坂も一人で歩けん。ヨシは、まず小さく試して、みんなの話を聞く。そこがナギに似ている。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 120.42,
      "e": 125.93,
      "t": "まあまあ、わたしもうなずくよ。ヨシなら、けんかの前に話を聞くもの。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 126.38,
      "e": 131.73,
      "t": "わたしは川上から一人で来た、よそ者だった。……それでも、いいのかい？"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 132.18,
      "e": 135.68,
      "t": "とうちゃんは、ずっと前からこの丘の者だよ！"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 136.13,
      "e": 144.06,
      "t": "わたし、とうちゃんに潮の読み方を習いたい。ナギばあが、とうちゃんに教えたみたいに。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 144.51,
      "e": 147.7,
      "t": "いいよ。ハナで、毎朝いっしょに見ようかなあ。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 148.15,
      "e": 155.78,
      "t": "それと、シロクボの白い物が、どうしてできるのか知りたい。天に聞いてみたい。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 156.23,
      "e": 161.8,
      "t": "わたしは、ハヤとのナカワシを続ける。それは天じゃなくて、自分でできるから。"
    },
    {
      "k": "ml",
      "j": 11,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 162.25,
      "e": 176.24,
      "t": "みんな、ありがとう。では決める。潮はイソが読み、ソヨはイソの弟子になる。蓄えはコイシが数える。天に届けるのは、シロクボの白い物がどうしてできるのか知りたいという、ソヨの願いにする。"
    }
  ]
}