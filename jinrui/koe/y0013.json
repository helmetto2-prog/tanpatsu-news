  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.31,
      "t": "13年目　トリシマの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.21,
      "e": 6.12,
      "t": "夏・読める"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 6.72,
      "e": 12.36,
      "t": "海草が、少しずつゆっくりになってきた。あわの筋も細い。……もうすぐシオネムリだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 12.81,
      "e": 13.67,
      "t": "なぜ分かる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 14.12,
      "e": 18.54,
      "t": "ゆうべ、海鳥が波の上で眠ってた。それに、月が丸い。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 18.99,
      "e": 19.56,
      "t": "……読める。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 20.01,
      "e": 22.61,
      "t": "ナギかあさん、今、なんて？"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 23.06,
      "e": 25.7,
      "t": "二度は言わない。カシに知らせておいで。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 26.9,
      "e": 29.17,
      "t": "夏・島の浜"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 29.77,
      "e": 32.68,
      "t": "着いた！ 足の下が、もうゆれない！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 33.13,
      "e": 36.69,
      "t": "ウルを浜の上まで引け。潮が来ても流されんようにだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 37.14,
      "e": 40.21,
      "t": "見て見て！ 岩の上、ぜんぶ鳥だ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 40.66,
      "e": 43.88,
      "t": "……この石。ぼくの首の石と、同じ色だ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 44.33,
      "e": 47.38,
      "t": "ほんとだ。イソ、ここから来たの？"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 47.83,
      "e": 51.37,
      "t": "わからない。でも、なんだか、なつかしいなあ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 51.82,
      "e": 55.42,
      "t": "日が傾く前に戻るぞ。ナギが火をたいて待っている。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 56.62,
      "e": 59.31,
      "t": "秋・薬草の袋"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 59.91,
      "e": 65.69,
      "t": "ツル、おいで。ひざが痛くてね、もう森まで歩けないんだよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 66.14,
      "e": 70.59,
      "t": "シイばあ、冷えたんだね。ユゲグサ、煮ようか？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 71.04,
      "e": 76.42,
      "t": "ありがとう。それより、この袋を、あんたが持っておくれ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 76.87,
      "e": 80.56,
      "t": "でも……わたし、暗い森はまだこわいよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 81.01,
      "e": 87.3,
      "t": "暗くなる前に帰ればいいんだよ。草は、明るいうちしか見えないからね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 87.75,
      "e": 91.65,
      "t": "……うん。わたし、今日から薬草の人だね！"
    },
    {
      "k": "m",
      "a": 92.85,
      "e": 95.51,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 96.11,
      "e": 101.78,
      "t": "島には湧き水も鳥もいた。浜には、ぼくの首の石と同じ、青い小石があった。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 102.23,
      "e": 107.77,
      "t": "帰りにもやが出て、ハナが見えなくなったの。でも、けむりだけは見えた。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 108.22,
      "e": 114.23,
      "t": "島へ渡る日は、ハナで火をたいて、けむりを上げておく。帰りの目印になる。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 114.68,
      "e": 118.18,
      "t": "それがいい。火の番は二人だ。掟どおりにな。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 118.63,
      "e": 124.96,
      "t": "たとえば、湿った草をくべると、けむりが白く太くなります。小さく試しておきましょう。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 125.41,
      "e": 129.16,
      "t": "鳥がヤマホドいる島だから、トリシマって呼ぼうよ！"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 129.61,
      "e": 134.74,
      "t": "トリシマもいいけど、ぼくは、やっぱり黒い石の取れる所が見たいな。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 135.19,
      "e": 144.54,
      "t": "静かな海の日を待って、ハナで何日も海を見た。静かな日は、あの一日だけだった。次の静かな日が、前もって分かればいいのになあ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 144.99,
      "e": 154.96,
      "t": "決めるよ。島へ渡る日は、ハナで火をたいて、けむりを上げておくこと。島の名は、ツルのトリシマでいい。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 155.41,
      "e": 164.8,
      "t": "薬草の袋は、もうツルが持っているね。今日からツルが薬草の人だよ。願いは、イソのにしよう。"
    }
  ]
}