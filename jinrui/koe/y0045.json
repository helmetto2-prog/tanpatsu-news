  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.53,
      "t": "45年目　ナエウタの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.43,
      "e": 6.51,
      "t": "春・ナエウタ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 7.11,
      "e": 13.13,
      "t": "ゆうべ、とうちゃんの夢を見たんだよ。縄をなう手が動いてて、いつもの歌を歌ってた！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 13.58,
      "e": 17.25,
      "t": "……その歌、とうちゃんの歌。手が、おぼえてる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 17.7,
      "e": 24.15,
      "t": "それだよ！ 歌の言葉の意味は分からないけど、ハヤたちの言葉に、少し似てる気がするんだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 24.6,
      "e": 27.75,
      "t": "縄をなうときの歌だから、ナエウタだね！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 28.2,
      "e": 33.16,
      "t": "ナエウタを、ナカビで歌ってみる。ハヤのかあさんなら、きっと分かるよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 33.61,
      "e": 34.37,
      "t": "……行ってこい。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 35.57,
      "e": 37.88,
      "t": "春・ヤナのことば"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 38.48,
      "e": 42.94,
      "t": "ヤナさんは、なんて言ってたの？ ぼくには、歌しか分からなかった。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 43.39,
      "e": 50.01,
      "t": "ナエウタは、川上の子守り歌なんだって。ヤナさんが小さいころ、兄さんが歌ってくれたって。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 50.46,
      "e": 53.26,
      "t": "兄さん……それって、ヨシじいのこと？"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 53.71,
      "e": 62.73,
      "t": "うん。とうちゃんは、ヤナさんの兄さんだったんだよ。黒い石は、とうちゃんが川上を出る日に、二つに割って分けたんだって。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 63.18,
      "e": 65.64,
      "t": "だから、黒い石がぴたりと合ったんだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 66.09,
      "e": 70.7,
      "t": "言葉は、まだ半分も分からない。でも、ちゃんと話せたよ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 71.9,
      "e": 74.03,
      "t": "夏・トリダマリ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 74.63,
      "e": 79.91,
      "t": "見て！ 海鳥が、あそこにばかり飛びこんでる！ 海の色が、そこだけちがう！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 80.36,
      "e": 85.85,
      "t": "鳥のたまる所の下には、魚の群れがいるんだよなあ。ナツ、よく見つけたなあ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 86.3,
      "e": 88.4,
      "t": "ヒロカイで、ぐるっと囲もう！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 88.85,
      "e": 95.98,
      "t": "もういい！ 舟べりから水が入ってる。魚を少し、海へ返して！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 96.43,
      "e": 97.73,
      "t": "せっかくとったのに……。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 98.18,
      "e": 105.12,
      "t": "帰れなかったら、魚も食べられない。クロミネの峰も、もう小さい。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 6,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 105.57,
      "e": 110.57,
      "t": "ソヨの言うとおりだなあ。トオカゲは、また今度にしよう。引き返そう。"
    },
    {
      "k": "m",
      "a": 111.77,
      "e": 114.43,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 115.03,
      "e": 119.17,
      "t": "蓄え、九十八かご。百に、二つ足りない。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 119.62,
      "e": 132.36,
      "t": "トリダマリで、オオウルに魚を積みすぎた。舟べりから水が入った。積むのは、舟べりが水から手のひら一つ出ているところまでにしたい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 132.81,
      "e": 138.39,
      "t": "ぼくは、もっと積めると思った。でも、ねえねが魚を返させたから、帰れた。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 138.84,
      "e": 140.95,
      "t": "なんで、手のひら一つ？"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 141.4,
      "e": 149.17,
      "t": "横から波が来ても、水が入らない高さだから。積みすぎて、やっと分かった。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 149.62,
      "e": 160.41,
      "t": "ナカビで、ヤナさんと話した。とうちゃんは、ヤナさんの兄さんだった。ヤナさんは、川上の村の年寄りたちが、とうちゃんの子に会いたがっていると言ってた。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 160.86,
      "e": 176.61,
      "t": "とうちゃんの生まれた村……。わたしも、この目で見てみたい。天への願いは、川上の、とうちゃんの生まれた村を見られますように、にしたい。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 177.06,
      "e": 182.66,
      "t": "ぼくは、カタミのからが楽に割れますように、がいいな。ことしは、たくさん拾ったから。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 183.11,
      "e": 199.99,
      "t": "では決める。オオウルに積むのは、舟べりが水から手のひら一つ出ているところまで。ナエウタの言葉は、クリが寄り合いでみんなに話す。天に届けるのは、川上の、ヨシの生まれた村をこの目で見られますようにという、ミルの願いにする。"
    }
  ]
}