  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 2.74,
      "t": "4年目　ホリヤの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 3.64,
      "e": 6.29,
      "t": "春・風の来ない穴"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 6.89,
      "e": 12.36,
      "t": "ゆうべ、からのネムリアナにしゃがんだ。風が、頭の上を通っていった。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 12.81,
      "e": 14.53,
      "t": "穴の中に、か。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 14.98,
      "e": 19.95,
      "t": "地面より低い所には、風が来ない。家の床を、掘ればいい。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 20.4,
      "e": 26.44,
      "t": "たとえば、ひざの深さに丸く掘って、その上に屋根をかける。まず小さく試してみよう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 26.89,
      "e": 28.7,
      "t": "掘るのはおれだ。行くぞ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 29.9,
      "e": 32.0,
      "t": "夏・石の目"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 32.6,
      "e": 37.09,
      "t": "じいちゃん！ 石割り、教えて。自分の刃がほしいんだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 37.54,
      "e": 43.15,
      "t": "……わしの手は、もうふるえる。たたいて見せることはできん。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 43.6,
      "e": 49.22,
      "t": "口でなら教えられるだろう。この子の手は、もうじっとしていないよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 49.67,
      "e": 60.02,
      "t": "よかろう。わしの口と、おまえの手じゃ。まず石の目を見よ。目に逆らって割る者は、指を割る。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 60.47,
      "e": 62.92,
      "t": "見て見て！ ここに細い線がある！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 63.37,
      "e": 67.32,
      "t": "それが目じゃ。そこを、軽く一つ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 68.52,
      "e": 70.8,
      "t": "秋・柱の木"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 71.4,
      "e": 74.95,
      "t": "この木なら柱になる。太くて、まっすぐだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 75.4,
      "e": 82.05,
      "t": "待って。それ、クリの木だよ。実をくれる木は切らないって決めたのに、なんで切るの？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 82.5,
      "e": 84.44,
      "t": "……みんなの家の柱が要るからだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 84.89,
      "e": 90.69,
      "t": "それに、この石のおのでは、この太さは何日かかっても切れない。刃が欠けてしまう。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 91.14,
      "e": 97.31,
      "t": "去年の大風で倒れた木なら、森の奥に何本もあるよ。わたし、場所を知ってる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 97.76,
      "e": 99.63,
      "t": "……分かった。案内しろ。"
    },
    {
      "k": "m",
      "a": 100.83,
      "e": 103.49,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 104.09,
      "e": 110.41,
      "t": "ホリヤは、風が来ない。炉の火もゆれない。だが、小さい。みんなは入れん。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 110.86,
      "e": 121.42,
      "t": "年寄りの体には、ありがたかったよ。ホリヤがみんなの分できるまでは、冬のホリヤには寒さに弱い者から寝かせておくれ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 121.87,
      "e": 129.0,
      "t": "みんなの分を建てるなら、太い柱が要る。だが実をくれる木は切れん。倒れた木は、もう少ない。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 129.45,
      "e": 134.61,
      "t": "掟は変えなくていいと思う。実をくれない木で、太いのを探せばいいよ。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 135.06,
      "e": 140.55,
      "t": "木はあっても、今の石のおのでは、太い木は切れない。たたくと刃が欠けてしまう。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 141.0,
      "e": 146.07,
      "t": "ぼく、じいちゃんに石割り習ってるよ！ もっと切れる刃、作る！"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 146.52,
      "e": 154.09,
      "t": "割った刃は、欠ける。……川原の石で、なにかできんかと、考えておる。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 154.54,
      "e": 163.91,
      "t": "決める。冬のホリヤには、寒さに弱い者から寝る。コナは、わしの石割りの弟子じゃ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 164.36,
      "e": 168.11,
      "t": "実をくれる木の掟は、そのままじゃ。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 168.56,
      "e": 172.31,
      "t": "願いは、太い木でも切れる、欠けないおのがほしい。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 172.76,
      "e": 176.57,
      "t": "ぼくは、あの浮かぶ木の中を、もっとくり抜けたらいいなあ。"
    },
    {
      "k": "ml",
      "j": 11,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 177.02,
      "e": 187.0,
      "t": "今年、天に届けるのは、カシの願いにする。おのが切れれば、柱も、ほかの物もできる。"
    }
  ]
}