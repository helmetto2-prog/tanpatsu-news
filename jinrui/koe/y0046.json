  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.74,
      "t": "46年目　トオミイワの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.64,
      "e": 6.77,
      "t": "春・トオミイワ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 7.37,
      "e": 15.42,
      "t": "コナにい、見て。川上の山すそに、けむりがいくつも立ってる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 15.87,
      "e": 22.36,
      "t": "ほんとだ！ ひとつ、ふたつ……もっとある。あれが、ヨシおじの生まれた村か。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 22.81,
      "e": 29.05,
      "t": "とうちゃんのかごも縄も、あそこで生まれたんだね。……きれい。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 29.5,
      "e": 31.4,
      "t": "もっと近くまで行きたいか？"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 31.85,
      "e": 41.37,
      "t": "行きたい。でも、ヤナさんたちに会ってから。今日は、見られただけでいい。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 41.82,
      "e": 44.49,
      "t": "なら、この岩の名前を決めてくれ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 44.94,
      "e": 48.72,
      "t": "遠くが見える岩だから、トオミイワ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 49.92,
      "e": 52.16,
      "t": "夏・浜の夜"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 52.76,
      "e": 59.65,
      "t": "コイシ、どうして浜まで来たの？ 縄なら、オキに持たせればいいのに。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 60.1,
      "e": 61.98,
      "t": "……ソヨに、渡したかった。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 62.43,
      "e": 66.59,
      "t": "また赤い縄？ もう手首に三回巻いてるよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 67.04,
      "e": 70.02,
      "t": "ちがう。……ずっと、ソヨのそばにいたい。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 70.47,
      "e": 74.53,
      "t": "……やっと言った。わたしも、そう思ってた。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 74.98,
      "e": 76.78,
      "t": "ホムラおばに、話す。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 77.23,
      "e": 82.45,
      "t": "うん。かあさん、きっと「なんで？」って聞くよ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 83.65,
      "e": 86.2,
      "t": "秋・炉ばたのホムラ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 86.8,
      "e": 91.5,
      "t": "かあさん、わたし、コイシとずっといっしょにいたい。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 91.95,
      "e": 98.53,
      "t": "なんで？……いや、聞かなくても分かる。その赤い縄を、毎朝さわってるもんね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 98.98,
      "e": 100.74,
      "t": "……ソヨを、大事にする。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 101.19,
      "e": 104.39,
      "t": "うん。コイシの縄は、ほどけないからね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 104.84,
      "e": 108.76,
      "t": "ホムラ、寒くないかなあ。毛皮をもう一枚かけようか。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 109.21,
      "e": 114.97,
      "t": "いい。イソ、海の向こうの話をして。わたしは、ここで聞いてる。"
    },
    {
      "k": "m",
      "a": 116.17,
      "e": 118.82,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 119.42,
      "e": 123.58,
      "t": "蓄え、九十かご。不作でも、冬は越せた。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 124.03,
      "e": 130.97,
      "t": "ことしは、ヒアテをしたクリの木も、実が少なかった。坂の若い木も、まだ実をつけない。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 131.42,
      "e": 141.49,
      "t": "長老を決めないとなあ。掟のとおり、みんながうなずける人を。……ぼくは、コナがいいと思うなあ。土と木の変わり目を、だれよりよく見ているから。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 141.94,
      "e": 146.27,
      "t": "コナなら、なんでそうするのか、ちゃんと話してくれるね！"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 146.72,
      "e": 152.05,
      "t": "……ぼくでいいなら、やる。ホムラねえのように、理由を聞いてから決める。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 152.5,
      "e": 161.37,
      "t": "トオミイワからけむりが見えたことを、次のナカビでヤナさんに話したい。川上の村へは、ヤナさんたちと日を決めてから行きたいんだ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 161.82,
      "e": 170.34,
      "t": "わたしも、それがいい。いきなり行ったら、川上の人がびっくりする。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 170.79,
      "e": 177.4,
      "t": "わたしとコイシは、次のワライヨの夜に、みんなの前で連れ合いになりたい。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 177.85,
      "e": 181.84,
      "t": "ぼくの願いは、カタミのからが楽に割れますように、がいいな。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 182.29,
      "e": 192.34,
      "t": "わたしの願いは、かあさんの見つけたナツユキの森のクリの木が、来年はたくさん実をつけますように、がいい。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 192.79,
      "e": 209.49,
      "t": "では決める。川上の村へは、ナカビでヤナたちと日を決めてから行く。ソヨとコイシは、次のワライヨの夜に連れ合いになる。天に届けるのは、ナツユキの森のクリの木が来年たくさん実をつけますようにという、ソヨの願いにする。"
    }
  ]
}