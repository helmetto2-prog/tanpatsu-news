  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.75,
      "t": "31年目　アシマキの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.65,
      "e": 7.28,
      "t": "春・カシじいの毛皮"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 7.88,
      "e": 12.63,
      "t": "カシじい、見て。この毛皮の上だと、貝がらを踏んでも痛くなかった。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 13.08,
      "e": 18.93,
      "t": "それは、おれが昔とったイノシシの皮だ。……薄いな。これでは、すぐ破れる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 19.38,
      "e": 22.87,
      "t": "これを使え。おれの肩の皮だ。厚いぞ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 23.32,
      "e": 25.26,
      "t": "でも、カシじいが寒くなる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 25.71,
      "e": 33.25,
      "t": "まあまあ、兄さんの肩には、わたしが新しい皮を縫ってあげるよ。オキ、足を出してごらん。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 33.7,
      "e": 36.19,
      "t": "縄、しばる。……きつくない？"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 36.64,
      "e": 39.66,
      "t": "きつくない。足を巻くから、アシマキって呼ぶ！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 40.86,
      "e": 44.02,
      "t": "夏・ハナの岩場をゆっくり"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 44.62,
      "e": 48.08,
      "t": "オキ、走らないで。一歩ずつ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 48.53,
      "e": 52.7,
      "t": "走ってないよ。……ねえね、貝がらの上を歩いても、痛くない！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 53.15,
      "e": 56.67,
      "t": "アシマキ、ぬれると重そうだなあ。ずれてないかい。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 57.12,
      "e": 59.8,
      "t": "少しずれた。でも、足は切れてない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 60.25,
      "e": 64.81,
      "t": "潮が満ちてくる。とうちゃん、戻る時だよね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 65.26,
      "e": 68.05,
      "t": "うん、戻ろう。ソヨの言うとおりだ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 69.25,
      "e": 71.57,
      "t": "秋・丘のはしで"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 72.17,
      "e": 74.11,
      "t": "オキ、アシマキはどうだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 74.56,
      "e": 78.49,
      "t": "岩場を、ねえねと同じに歩けた。カシじいの皮のおかげだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 78.94,
      "e": 85.96,
      "t": "そうか。……ホムラ、狩りの先頭は、もうおまえのものだ。うしろから見ていて、よく分かった。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 86.41,
      "e": 91.34,
      "t": "なんで今、そんなことを言うの。父さんは、まだうしろにいてよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 91.79,
      "e": 96.46,
      "t": "うしろには、もう、こいつらがいる。行け、ホムラ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 96.91,
      "e": 100.75,
      "t": "……分かった。父さんの見ていた所まで、わたしが見る。"
    },
    {
      "k": "m",
      "a": 101.95,
      "e": 104.6,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 105.2,
      "e": 109.3,
      "t": "数えた。小石が残る。冬の終わりまで、足りる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 109.75,
      "e": 116.24,
      "t": "カシのいない冬は、はじめてだね。狩りの頭は、ホムラにまかせたいと思うが、どうだろう。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 116.69,
      "e": 123.07,
      "t": "まあまあ、兄さんもきっと、そう言うよ。ホムラなら、みんなに肉を届けてくれる。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 123.52,
      "e": 127.28,
      "t": "父さんにも言われた。狩りの頭は、わたしがやる。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 127.73,
      "e": 138.18,
      "t": "アシマキを巻いたら、オキは岩場で一度も足を切らなかった。岩場へ行く子は、アシマキを巻いて行くことにしたい。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 138.63,
      "e": 142.79,
      "t": "ぼくのアシマキは、ずれないように、アケビばあがひもを足してくれた。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 143.24,
      "e": 149.55,
      "t": "わたしは、浅瀬の岩をこえて、ハヤと同じ火のそばで話してみたい。天にお願いしたい。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 150.0,
      "e": 155.15,
      "t": "岩をこえるのは、掟があるからなあ。でも、天に願うのはいいかなあ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 155.6,
      "e": 170.56,
      "t": "みんな、ありがとう。では決める。狩りの頭はホムラにする。岩場へ行く子どもと若者は、アシマキを巻いて行く。天に届けるのは、浅瀬の岩をこえてハヤと同じ火のそばで話せるようにという、クリの願いにする。"
    }
  ]
}