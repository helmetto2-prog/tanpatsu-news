  "hash": "a76de304772c6a075cd33278",
  "made": "2026-10-24 10:09",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.23,
      "t": "9年目　ツバメツチの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.13,
      "e": 6.75,
      "t": "春・落ちたツバメの巣"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 7.35,
      "e": 12.42,
      "t": "ヨシおじ、それ、鳥の巣？ 泥なのに、こわれてない！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 12.87,
      "e": 19.84,
      "t": "落ちても、くずれていません。たとえば、ここの割れ口……細い草が、ぎっしりまざっています。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 20.29,
      "e": 23.26,
      "t": "こっちの泥のかたまりは、ひびだらけだよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 23.71,
      "e": 28.52,
      "t": "草のない泥は割れて、草のある泥は割れない。小さく試してみましょう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 28.97,
      "e": 35.04,
      "t": "まあ、ツバメは器づくりの先生だったんだね。草なら、いくらでもあるよ！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 36.24,
      "e": 38.55,
      "t": "夏・鳴らない火"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 39.15,
      "e": 42.74,
      "t": "ねえ、今年は、ぱちんって言わないね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 43.19,
      "e": 47.48,
      "t": "数えた。焼いたのはテノカズと三つ。割れたのは三つ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 47.93,
      "e": 52.28,
      "t": "去年は、残ったのがたった一つでした。ツバメの言うとおりです。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 52.73,
      "e": 55.9,
      "t": "ツバメのまねをした土だから……ツバメツチ！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 56.35,
      "e": 61.89,
      "t": "ツバメツチのグツ、いい名前。これで冬も、毎日煮られるよ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 63.09,
      "e": 65.44,
      "t": "秋・朝のけむり"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 66.04,
      "e": 76.21,
      "t": "ねえイソ兄、知ってる？ ホムラ姉ね、夏のあいだ毎朝、だれよりも先に丘のはしで、浜のけむりを待ってたんだよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 76.66,
      "e": 81.56,
      "t": "ツル！ ……それは、ハマモリの無事を見るのは、みんなの役目だから。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 82.01,
      "e": 87.64,
      "t": "でも、けむりが見えるまで、ずっと動かなかったよ。ケムリマチだね！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 88.09,
      "e": 92.4,
      "t": "……ぼくもね、毎朝、火をつける前に、丘のほうを見てたんだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 92.85,
      "e": 95.32,
      "t": "……なんで、それを先に言わないの。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 95.77,
      "e": 98.84,
      "t": "二人とも。火が冷える。もっと寄りな。"
    },
    {
      "k": "m",
      "a": 100.04,
      "e": 102.7,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 103.3,
      "e": 114.6,
      "t": "ツバメの巣がなければ、グツは今も一つきりでした。巣は、ツバメが帰ってくる場所です。落ちた巣はもらってよいけれど、かかっている巣は落とさない。そう決めたいのです。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 115.05,
      "e": 118.73,
      "t": "まあ、ツバメへのお礼だね。わたしもそれがいい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 119.18,
      "e": 122.58,
      "t": "ツバメは、とって食う鳥じゃない。それでいい。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 123.03,
      "e": 128.52,
      "t": "グツがこんなにある。よその人に見せたら、黒い石ととりかえてくれるかもしれない。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 128.97,
      "e": 132.43,
      "t": "川上へは、こちらから行かない。決めたことだ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 132.88,
      "e": 138.63,
      "t": "なんで？ 先に手を出さなければいいんでしょう。会うだけなら、けんかにならない。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 139.08,
      "e": 145.44,
      "t": "ぼくは、黒い石みたいにうすく割れる石がほしい。あれなら、とがった先が作れる。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 145.89,
      "e": 151.37,
      "t": "……川上の人が、みんなこわいわけではありません。それだけは、言っておきます。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 151.82,
      "e": 161.88,
      "t": "決めるよ。ヨシの言うとおり、かかっているツバメの巣は落とさない。川上へこちらから行かないのは、今までどおり。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 162.33,
      "e": 172.37,
      "t": "天に届けるのは、ホムラの願いにしよう。けんかをせずに会えますように、とね。それなら、だれもけがをしない。"
    }
  ]
}