  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.81,
      "t": "36年目　ヨリギヤマの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.71,
      "e": 7.66,
      "t": "春・川岸の赤い筋"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 8.26,
      "e": 17.5,
      "t": "コナ、見て。川岸のがけに、赤い筋が一本、横にのびてる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 17.95,
      "e": 21.77,
      "t": "ほんとだ！ こすったら、指がヒイシの色になった。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 22.22,
      "e": 32.7,
      "t": "……前に、だまって一人で汁を使って、ごめんね。だから今日は、コナを呼んだの。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 33.15,
      "e": 39.34,
      "t": "ちゃんと呼んでくれて、うれしいよ。がけはくずれやすいから、二人で少しずつ取ろう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 39.79,
      "e": 43.58,
      "t": "赤いがけだから、アカガケって呼ぶね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 44.03,
      "e": 49.79,
      "t": "アカガケか。今日は、かご一つぶんだけ持って帰ろう。また二人で来ればいい。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 50.99,
      "e": 54.02,
      "t": "秋・大風のあとの浜"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 54.62,
      "e": 56.9,
      "t": "ねえね、浜じゅう流木だらけだ！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 57.35,
      "e": 65.46,
      "t": "これだけあれば、冬もナミノコが煮られる。……コイシ、前に、けちって言ってごめん。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 65.91,
      "e": 69.46,
      "t": "いい。たきぎを数えるのは、ぼくの役だから。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 69.91,
      "e": 73.59,
      "t": "でも、ぬれた木は燃えない。積んで、乾かす。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 74.04,
      "e": 80.16,
      "t": "風が通るように組めばいいね。スナカゲなら、北の風もよけられる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 80.61,
      "e": 82.32,
      "t": "縄でしばる。やる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 82.77,
      "e": 85.7,
      "t": "浜に寄ってきた木の山だから、ヨリギヤマだね。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 86.9,
      "e": 89.62,
      "t": "秋・澄んだ朝のハナ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 90.22,
      "e": 95.92,
      "t": "とうちゃん、見て！ 島のずっと向こうに、青い影がある。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 96.37,
      "e": 100.63,
      "t": "トオカゲだなあ。大風のあとは、こんなにくっきり見えるんだなあ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 101.08,
      "e": 103.62,
      "t": "なんで、そんなにじっと見てるの？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 104.07,
      "e": 110.22,
      "t": "ソヨもオキも大人になった。潮を読める者もふえた。……行ってみたい気持ちが、また起きてきたかなあ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 110.67,
      "e": 117.12,
      "t": "わかった。行くなら、いっしょに考えるって言ったよね。寄り合いで、みんなに話して。"
    },
    {
      "k": "m",
      "a": 118.32,
      "e": 120.98,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 121.58,
      "e": 127.02,
      "t": "数えた。小石、去年よりたくさん並んだ。冬は、楽にこせる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 127.47,
      "e": 134.03,
      "t": "ヨリギヤマのおかげで、冬でもナミノコが煮られた。コイシと組んで積んだの。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 134.48,
      "e": 143.58,
      "t": "アカガケのがけは、大水でくずれたばかりで、まだくずれやすい。アカガケへは二人で行って、取るのはかご一つまでにしよう。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 144.03,
      "e": 152.74,
      "t": "かご一つずつなら、何年も赤い線が引ける。わたしも、それがいい。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 153.19,
      "e": 158.06,
      "t": "わたしは、ナカビで会ったハヤのかあさんと、もっと話せるようになりたい。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 158.51,
      "e": 165.44,
      "t": "大風のあとの朝、トオカゲがくっきり見えたんだ。トオカゲへ行く道が分かるように、天にお願いしたいなあ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 165.89,
      "e": 172.53,
      "t": "行くかどうかは、またみんなで決める。でも、道を知りたいっていうのは、わたしも分かる。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 172.98,
      "e": 186.3,
      "t": "まあまあ、みんなありがとう。では決める。アカガケへは二人で行き、取るのはかご一つまで。天に届けるのは、トオカゲへ行く道が分かるようにという、イソの願いにする。"
    }
  ]
}