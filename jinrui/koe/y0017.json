  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.77,
      "t": "17年目　東のけむりの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.67,
      "e": 7.44,
      "t": "春・片側だけの屋根"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 8.04,
      "e": 14.72,
      "t": "浜の小屋の屋根、片っぽだけ残ってたんだ。土と草がのってた方だけ、風でもびくともしなかったよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 15.17,
      "e": 23.03,
      "t": "たとえば、柱をもっと深く埋めて、屋根の上に土を重ねれば、風に押さえがききます。小さく試してみよう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 23.48,
      "e": 28.91,
      "t": "土なら、まかせてよ。西の湿地のねばる土を、かごで運ぼう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "ずんだもん",
      "a": 29.36,
      "e": 32.23,
      "t": "土をのせた屋根？ 重たそうだね！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 32.68,
      "e": 35.66,
      "t": "重たいくらいがいいんだ。風に負けないからさ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "ずんだもん",
      "a": 36.11,
      "e": 38.8,
      "t": "重たい屋根だから、オモヤネだね！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 40.0,
      "e": 42.51,
      "t": "夏・東のけむり"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 43.11,
      "e": 47.77,
      "t": "ナギかあさん、あれ見て。東の海辺のずっと先、けむりだよね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 48.22,
      "e": 50.21,
      "t": "……けむりだ。たき火のけむり。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 50.66,
      "e": 54.38,
      "t": "川上の人たちとは方角がちがうね。だれだろう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 54.83,
      "e": 58.44,
      "t": "わたしの生まれた群れは、東の海辺へ移っていった。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 58.89,
      "e": 60.99,
      "t": "じゃあ、あれはナギかあさんの……。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 61.44,
      "e": 64.93,
      "t": "分からない。けむりは、だれのけむりか言わない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 65.38,
      "e": 67.7,
      "t": "ねえ、ウルで行ってみる？"
    },
    {
      "k": "l",
      "s": 1,
      "j": 7,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 68.15,
      "e": 73.3,
      "t": "岸の見えない所へは出さない。それが掟だ。……今日は、見るだけ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 74.5,
      "e": 77.49,
      "t": "秋・オクノサワの薬草"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 78.09,
      "e": 84.05,
      "t": "ソヨのせき、ユゲグサの葉が足りない。オクノサワの薬草があればいいのに。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 84.5,
      "e": 88.05,
      "t": "ぼくが取ってくる。ヒモリには、もう言ってある。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 88.5,
      "e": 91.1,
      "t": "また手を真っ赤にして帰ってくるんでしょ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 91.55,
      "e": 96.47,
      "t": "見て。手を葉と皮で包んでいく。ツルが言いだした掟のとおりにさ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 96.92,
      "e": 100.68,
      "t": "……帰ってきた。ほんとうに、どこもかぶれてない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 101.13,
      "e": 105.66,
      "t": "汁を取るより、薬草を取るほうが、ずっとやさしかったよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 6,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 106.11,
      "e": 110.25,
      "t": "ありがとう、コナ。前は、言いすぎたね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 7,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 110.7,
      "e": 114.59,
      "t": "ぼくも。ツルの掟がなかったら、また真っ赤だった。"
    },
    {
      "k": "s",
      "s": 3,
      "a": 115.79,
      "e": 117.57,
      "t": "秋・オキ"
    },
    {
      "k": "l",
      "s": 3,
      "j": 0,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 118.17,
      "e": 124.0,
      "t": "ツル、今日は、わたしは声を出さないよ。そばで見ているだけだ。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 124.45,
      "e": 129.24,
      "t": "うん。湯はわいてる。ホムラねえ、息に合わせてね。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 129.69,
      "e": 132.98,
      "t": "……だいじょうぶ。ソヨのときより、こわくない。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 133.43,
      "e": 136.65,
      "t": "出てきた……男の子だよ！ 泣いた！"
    },
    {
      "k": "l",
      "s": 3,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 137.1,
      "e": 145.34,
      "t": "ぼくらの子が、二人になった。……ぼくは、ずっと遠くの海のことを、オキって呼んでるんだ。この子も、オキにしようよ。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 145.79,
      "e": 148.86,
      "t": "オキ。ソヨとオキ。いい名前だね。"
    },
    {
      "k": "m",
      "a": 150.06,
      "e": 152.71,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 153.31,
      "e": 159.08,
      "t": "ネムリアナも、カチガイのかごも、からになった。春まで、まだひと月ある。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 159.53,
      "e": 164.66,
      "t": "根を掘る。干潟の貝も掘る。おれたち大人は、食べるのをあとにする。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 165.11,
      "e": 172.03,
      "t": "まあまあ、それなら決まりにしようよ。おなかのすく冬は、子どもと乳をやる母から先に食べる。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 172.48,
      "e": 179.45,
      "t": "夏にカチガイをもっと干せば、冬にも足せます。オモヤネの小屋なら、秋の風でもかごが飛ばされません。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 179.9,
      "e": 185.56,
      "t": "天には、次の冬は子どもたちがおなかをすかせませんように、と願いたいな。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 186.01,
      "e": 192.78,
      "t": "わたしは、東の浜のけむりの人たちに、もう一度会いたい。わたしの生まれた群れかもしれない。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 193.23,
      "e": 218.45,
      "t": "決めるよ。おなかのすく冬は、子どもと乳をやる母から先に食べること。カチガイは、夏にもっと干すこと。食べ物のことは、わたしたちの手でできる。会いたい気持ちは、天にしか届けられないからね。天に届けるのは、ナギの、東のけむりの人々に会いたいという願いにしよう。"
    }
  ]
}