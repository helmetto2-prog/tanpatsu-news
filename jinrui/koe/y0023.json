  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.66,
      "t": "23年目　ハジケマメの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.56,
      "e": 6.88,
      "t": "春・はじける豆"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 7.48,
      "e": 12.08,
      "t": "見て、ミル。キジがつついていた、つる草の細いさやだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p12",
      "n": "ミル",
      "v": "小夜/SAYO",
      "a": 12.53,
      "e": 19.39,
      "t": "これ、きれい。丸くて、小さい。……あっ、さわったら、はじけた！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "小夜/SAYO",
      "a": 19.84,
      "e": 22.45,
      "t": "はじける豆だから、ハジケマメ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 22.9,
      "e": 30.39,
      "t": "足もとを見て。こぼれた豆から、もう芽が出てる。クリの実と同じだ。まけば、また生えるんだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "小夜/SAYO",
      "a": 30.84,
      "e": 33.64,
      "t": "ここの豆、ぜんぶ持って帰る？"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 34.09,
      "e": 42.34,
      "t": "ぜんぶは取らない。ここにも残しておく。持って帰った豆は、丘のはしに少しだけまいて、小さく試そう。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 43.54,
      "e": 46.21,
      "t": "夏・シカの足あと"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 46.81,
      "e": 49.42,
      "t": "ハジケマメの葉が、またなくなってる……。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 49.87,
      "e": 55.94,
      "t": "見せて。……シカだ。夜明けに、沢の方から二頭来てる。足あとが新しい。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 56.39,
      "e": 59.56,
      "t": "ねえさん、豆なんか、って言ってたのに。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 60.01,
      "e": 67.08,
      "t": "言った。でも、なんで豆をまくのか、ちゃんと聞いてなかった。実の少ない年のためなんでしょ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 67.53,
      "e": 71.57,
      "t": "うん。クリの木みたいに、まけば、また生える。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 72.02,
      "e": 78.22,
      "t": "じゃあ、夜はホエをここに寝かせよう。シカは、犬のにおいのする所には来ない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 78.67,
      "e": 80.43,
      "t": "……ありがとう、ねえさん。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 81.63,
      "e": 83.86,
      "t": "冬・炉のそばで"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 84.46,
      "e": 88.35,
      "t": "とうちゃん、ナギおば。聞いてほしいことがあるの。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 88.8,
      "e": 92.77,
      "t": "ぼくとツルは、これから、いっしょに暮らしたいと思ってる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 93.22,
      "e": 99.17,
      "t": "なるほど。このごろツルの歌に、コナの名前がよく出てくるのは、そういうわけでしたか。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 99.62,
      "e": 103.59,
      "t": "知っていた。秋、二人のかごの並び方を見た。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 104.04,
      "e": 106.66,
      "t": "春のワライヨの夜に、みんなに言え。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 107.11,
      "e": 111.27,
      "t": "うん！ シイばあとトチじいにも、聞いてもらえるね。"
    },
    {
      "k": "m",
      "a": 112.47,
      "e": 115.12,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 115.72,
      "e": 120.41,
      "t": "数えた。冬の終わりで、オオイシが一つと、小石が三つ残ってる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 120.86,
      "e": 127.86,
      "t": "梁につるしたハジケマメは、次の春にまく分だ。おなかがすいても、冬には食べないでほしい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 128.31,
      "e": 131.33,
      "t": "なんで？ 煮たら、おいしかったよ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 131.78,
      "e": 137.7,
      "t": "食べてしまったら、春にまく豆がなくなる。そうしたら、秋に豆はとれない。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 138.15,
      "e": 142.25,
      "t": "クリの実を埋めたときと同じだ。コナ、袋はおまえが持て。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 142.7,
      "e": 150.12,
      "t": "ぼくは、トリシマの青い小石がどこから来たのか、やっぱり知りたいなあ。海の向こうってさ、だれかいるのかなあ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 150.57,
      "e": 163.38,
      "t": "決める。次の春にまく豆は、冬に食べずに残す。袋はコナが持つ。天に届けるのは、イソの、トリシマの青い小石がどこから来たのか分かりますようにという願いにする。"
    }
  ]
}