{
  "schema": 1,
  "year": 19,
  "title": "19年目　ホエの来た年",
  "src": "y0019.mp3",
  "dur": 148.6,
  "hash": "3fd408c5466a871c059a02e1",
  "made": "2026-10-28 00:52",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.4,
      "t": "19年目　ホエの来た年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.3,
      "e": 6.95,
      "t": "夏・東の入り浜"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 7.55,
      "e": 11.8,
      "t": "見て、炉の石だ。輪が一つ、二つ……もっとある。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 12.25,
      "e": 18.94,
      "t": "石が黒くすすけています。一晩や二晩ではない。たとえば、何年も冬をここで越したのでしょう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 19.39,
      "e": 24.78,
      "t": "こっちの草の山、ふむとがりがり鳴るよ。中は全部、貝がらだ！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 25.23,
      "e": 31.63,
      "t": "……母さんの浜にも、こういう山があった。貝を食べて、からを一つの所に捨てていた。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 32.08,
      "e": 35.8,
      "t": "じゃあ、ナギかあさんの群れが、ここに住んでたのかなあ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 36.25,
      "e": 40.05,
      "t": "分からない。でも、浜で冬を越せる人々がいる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 40.5,
      "e": 45.92,
      "t": "かごの切れ端です。目がななめに詰んでいる。流れ着いたかごと同じ編み方だ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 47.12,
      "e": 49.7,
      "t": "夏・コイシのひみつ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "小夜/SAYO",
      "a": 50.3,
      "e": 55.88,
      "t": "母さん、コイシがまた干し魚をにぎって、丘のはずれへ行った。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 56.33,
      "e": 58.95,
      "t": "まあまあ、おなかがすいたんでしょうよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "小夜/SAYO",
      "a": 59.4,
      "e": 65.27,
      "t": "ちがう。自分の分を食べないで持っていくの。ほら、ついて来た！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 65.72,
      "e": 71.63,
      "t": "犬だ。浜から岸づたいについて来たのかな。コイシ、なんで隠してたの？"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 72.08,
      "e": 74.71,
      "t": "……これ、ぼくの分。ぼくが、やった。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p12",
      "n": "ミル",
      "v": "小夜/SAYO",
      "a": 75.16,
      "e": 79.15,
      "t": "わっ、ほえた！ ほえて知らせるから、ホエだね！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 79.6,
      "e": 86.44,
      "t": "自分の分を分けてたなら、だれも怒らないよ。でも、置くかどうかは寄り合いで決めようね。"
    },
    {
      "k": "m",
      "a": 87.64,
      "e": 90.29,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 90.89,
      "e": 94.67,
      "t": "ネムリアナは五つ。春まで食べても、まだ残る。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 95.12,
      "e": 99.84,
      "t": "あの夜、ホエがほえなければ、新しい穴はイノシシに掘られていた。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 100.29,
      "e": 106.09,
      "t": "でも、とった物はみんなで分ける掟だよ。ホエにも分けるの？ なんで？"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 106.54,
      "e": 111.72,
      "t": "たとえば、獣の骨と、人の食べない残りなら、だれの分も減りません。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 112.17,
      "e": 118.41,
      "t": "それならいい。ホエには、骨と残りを分ける。人の分は、コイシのでも分けない。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 118.86,
      "e": 120.73,
      "t": "……ホエ、ずっといてほしい。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 121.18,
      "e": 129.17,
      "t": "入り浜の人々は、浜で冬を越していた。わたしは、浜の近くに、冬もみんなで住めるホリヤがほしい。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 129.62,
      "e": 147.6,
      "t": "決めるよ。ホエは村に置く。ホエには、とった獣の骨と人の食べない残りを分けて、人の分は分けないこと。天に届けるのは、ナギの、浜の近くに冬も住めるホリヤを建てたいという願いにしよう。"
    }
  ]
}