  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.38,
      "t": "34年目　ヒイシの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.28,
      "e": 7.13,
      "t": "夏・くずれたネムリアナ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 7.73,
      "e": 12.24,
      "t": "ゆうべ、ずっとゆれてた！ 見て、ネムリアナのふちが、くずれてる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 12.69,
      "e": 16.06,
      "t": "……からで、よかった。秋までに、直す。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 16.51,
      "e": 23.53,
      "t": "まあまあ、だれもけがしなくて何よりだよ。イシイズミみたいに、ふちを石で囲んだらどうかね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 23.98,
      "e": 27.08,
      "t": "石なら、くずれない。川原から運ぶ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 27.53,
      "e": 30.67,
      "t": "ぼくも運ぶ。かごに入るだけ、何度でも。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 31.12,
      "e": 34.34,
      "t": "じゃあ、わたしは歌でもうたって手伝おうかね。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 35.54,
      "e": 38.3,
      "t": "秋・赤い線のグツ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 38.9,
      "e": 42.23,
      "t": "かあ、見て。赤いグツ！ ……ゆび、かゆい。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 42.68,
      "e": 49.13,
      "t": "ナツ、こっちへ。ヒヤシバで包むからね。……このグツ、だれが塗ったの？"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 49.58,
      "e": 57.69,
      "t": "……わたし。川原で見つけた赤い石をすって、カブレギの汁にまぜたの。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 58.14,
      "e": 62.44,
      "t": "ひとりで汁を使ったのか。なんで、ぼくに言わなかったんだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 62.89,
      "e": 71.69,
      "t": "かあさんに、おどろいてほしかったの。ごめんなさい。ナツも、ごめんね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 72.14,
      "e": 77.03,
      "t": "……手は、ちゃんと包んでたんだな。それなら、次はいっしょに塗ろう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 77.48,
      "e": 80.52,
      "t": "乾くまでの置き場所も、決めないとね。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 81.72,
      "e": 84.71,
      "t": "冬・炉のそばのおくり物"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 85.31,
      "e": 91.19,
      "t": "かあさん。これ、ヒイシの赤で線を引いたグツ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 91.64,
      "e": 98.07,
      "t": "まあ、夕やけみたいな色だねえ。グツを作ったわたしも、こんな色は知らなかったよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 98.52,
      "e": 103.12,
      "t": "とうちゃんのかごの底に、ずっとしまってたの。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 103.57,
      "e": 107.61,
      "t": "じゃあ、このグツでクリの実を煮て、みんなで食べようよ。"
    },
    {
      "k": "m",
      "a": 108.81,
      "e": 111.47,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 112.07,
      "e": 116.7,
      "t": "数えた。小石が、ずっと残る。クリの実が多い年だった。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 117.15,
      "e": 122.23,
      "t": "くずれたネムリアナは、ふちを石で囲んだ。ほかの二つも、囲みたい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 122.68,
      "e": 131.2,
      "t": "汁を塗った物は、丘の大きい小屋の梁につるして乾かそう。高い所なら、子どもの手がとどかないから。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 131.65,
      "e": 138.49,
      "t": "なんで梁なの？ ……そうか、かごのうしろだと、ナツみたいに見つけちゃうからだね。わかった。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 138.94,
      "e": 148.16,
      "t": "ヒイシは、手のひらに乗るだけしかないの。ヒイシがもっと見つかるように、願いたい。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 148.61,
      "e": 158.91,
      "t": "わたしは、ハヤの群れの人たちに会いたい。ハヤが、指を何本も立てて川上を指したの。ナカビで群れの人たちに会えるように、天にお願いしたい。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 159.36,
      "e": 177.45,
      "t": "まあまあ、みんなありがとう。では決める。汁を塗った物は、丘の大きい小屋の梁につるして乾かす。ほかの二つのネムリアナも、石で囲もう。天に届けるのは、ナカビでハヤの群れの人たちに会えるようにという、クリの願いにする。"
    }
  ]
}