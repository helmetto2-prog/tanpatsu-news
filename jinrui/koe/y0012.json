  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.2,
      "t": "12年目　ウミカワの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.1,
      "e": 6.59,
      "t": "春・ハナの流木"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 7.19,
      "e": 11.13,
      "t": "見て、この長さ。はじめのウルより、ずっと長い。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 11.58,
      "e": 17.31,
      "t": "これ、どうやって丘の浜まで運ぶの？ 重くて、三人でも持てないよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 17.76,
      "e": 23.98,
      "t": "たとえば、潮の満ちるときに浮かべて、ウルで引けばいい。運ばずに、流すのです。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 24.43,
      "e": 27.83,
      "t": "ヨシ、これをくり抜いたら、二人でこげるかなあ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 28.28,
      "e": 34.33,
      "t": "前と後ろに一人ずつ。水をかく板も、二枚作りましょう。小さく試してから。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 35.53,
      "e": 37.62,
      "t": "夏・ウミカワ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 38.22,
      "e": 42.1,
      "t": "イソ、ウルが勝手に東へ行く！ こいでないのに！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 42.55,
      "e": 45.89,
      "t": "あわの筋に入った。戻る。岸ぞいに。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 46.34,
      "e": 49.17,
      "t": "海の中に……川がある。ウミカワだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 49.62,
      "e": 54.41,
      "t": "この川は、いつも同じではない。強い日も、弱い日もある。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 54.86,
      "e": 61.23,
      "t": "ナギかあさん。ぼくに、潮の読み方を教えてほしい。島へ行くなら、自分で読めないと。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 61.68,
      "e": 64.98,
      "t": "……毎日、浜で見る。それができるなら。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 66.18,
      "e": 68.48,
      "t": "秋・シオネムリ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 69.08,
      "e": 72.32,
      "t": "海草を見る。さっきまで東へなびいていた。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 72.77,
      "e": 75.54,
      "t": "……止まった。あわの筋も、消えていく。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p11",
      "n": "クリ",
      "v": "ずんだもん",
      "a": 75.99,
      "e": 78.83,
      "t": "潮がねむってる！ シオネムリだね！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 79.28,
      "e": 83.91,
      "t": "そう。ウミカワがゆるむのは、このときだけ。長くはない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 84.36,
      "e": 89.19,
      "t": "シオネムリのうちに行って、次のシオネムリまでに帰る……そういうことかなあ。"
    },
    {
      "k": "m",
      "a": 90.39,
      "e": 93.05,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 93.65,
      "e": 99.19,
      "t": "二つ目のウルができた。ウミカワがゆるむシオネムリのときなら、島まで行けると思うんだ。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 99.64,
      "e": 105.75,
      "t": "シオネムリは長くない。行って帰ってくるまで、海がもつかどうかは、まだ分からない。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 106.2,
      "e": 113.12,
      "t": "ウルが一つで出て、ひっくり返ったら、だれが助ける。島の方へ出すなら、二つ並べてだ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 113.57,
      "e": 119.63,
      "t": "二つ目のウルは、二人でこげば速く進みます。はじめのウルと並べても、おくれません。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 120.08,
      "e": 125.04,
      "t": "島もいいけど、ぼくは黒い石の取れる所も、いつか見てみたい。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "ずんだもん",
      "a": 125.49,
      "e": 129.18,
      "t": "わたしも、ミルとコイシと、ウルに乗ってみたい！"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 129.63,
      "e": 137.51,
      "t": "イソが島へ渡る日には、潮と風が、帰るまでおだやかであってほしい。それは、わたしにも読みきれない。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 137.96,
      "e": 151.53,
      "t": "決めるよ。島の方へ出るときは、ウルを二つ並べて出す。イソは、ナギが『もう読める』と言うまで習う。島へ渡るのは、それからだよ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 151.98,
      "e": 159.19,
      "t": "クリたちは、大人といっしょに浅瀬で乗せてもらおうね。願いは、ナギのにしよう。"
    }
  ]
}