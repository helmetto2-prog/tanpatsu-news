{
  "schema": 1,
  "year": 38,
  "title": "38年目　合わさった石の年",
  "src": "y0038.mp3",
  "dur": 238.14,
  "hash": "b8ff64ab649ac97a0e7e8f7d",
  "made": "2026-11-17 00:56",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 4.14,
      "t": "38年目　合わさった石の年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 5.04,
      "e": 7.56,
      "t": "春・合わさった石"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 8.16,
      "e": 13.06,
      "t": "かあちゃん、見て！ 浅瀬の岩に、黒い石のかけらが置いてあったの。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 13.51,
      "e": 16.21,
      "t": "まあ、ヨシの石とおんなじ色だねえ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 16.66,
      "e": 22.43,
      "t": "とうちゃんの石と並べたら、割れ口がぴたりと合ったんだよ。もとは一つの石だったんだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 22.88,
      "e": 28.88,
      "t": "……ヨシは川上を出るとき、だれかと、この石を二つに分けたのかもしれないね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 29.33,
      "e": 36.54,
      "t": "ハヤのかあさんが目をとじたのは、きっと、この石のためだね。でも、ほんとうのわけは、まだ聞けない。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 36.99,
      "e": 43.2,
      "t": "まあまあ、あせらないで。川上の言葉は、クリが少しずつ覚えていけばいいよ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 44.4,
      "e": 47.19,
      "t": "夏・縄の目のかけら"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 47.79,
      "e": 52.52,
      "t": "ねえ、見て。グツのかけらだけど、外に細い筋がいっぱいついてる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 52.97,
      "e": 54.69,
      "t": "……ぼくの縄の、より目。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 55.14,
      "e": 62.61,
      "t": "ほんとだ。縄を押しつけたんだねえ。東の風で流れてきたんだから、東の浜のだれかが焼いたのかな。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 63.06,
      "e": 66.57,
      "t": "さわると、ざらざらしてて、ぬれた手でもすべらないよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 67.02,
      "e": 73.58,
      "t": "それはいいねえ。わたしは近ごろ、熱いグツを持つと手がすべって、こわいんだよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 74.03,
      "e": 76.19,
      "t": "縄なら、ある。やる。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 77.39,
      "e": 80.03,
      "t": "夏・ナワメをつける"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 80.63,
      "e": 89.07,
      "t": "ナツ、こっちにおいで。この縄を、ぬれた土の上で転がしてみて。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 89.52,
      "e": 92.46,
      "t": "……ミルねえの物にさわると、また指がかゆくなる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 92.91,
      "e": 103.37,
      "t": "これは汁を塗っていない、ただの土だよ。かゆくならない。あのときは、ごめんね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 103.82,
      "e": 108.06,
      "t": "ほんと？ ……転がすよ。見て、縄の目がついた！ ナワメだ！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 108.51,
      "e": 110.93,
      "t": "いい筋。もっと、ゆっくり。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 111.38,
      "e": 118.24,
      "t": "ナツの手、上手だね。次のグツも、いっしょにやろう。"
    },
    {
      "k": "s",
      "s": 3,
      "a": 119.44,
      "e": 121.97,
      "t": "秋・ナカビの石"
    },
    {
      "k": "l",
      "s": 3,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 122.57,
      "e": 124.56,
      "t": "来た。ハヤと、かあさんだ。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 1,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 125.01,
      "e": 131.2,
      "t": "ハヤのかあさん、見て。とうちゃんの石と、岩に置いてくれた石が、ぴたりと合ったよ。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 131.65,
      "e": 138.04,
      "t": "かあさん、石を両手で包んでる。……自分の胸を指して、それから、ひざくらいの高さに手を出してる。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 138.49,
      "e": 143.89,
      "t": "小さい子のこと、かな。小さいころのとうちゃんを、知っているのかもしれない。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 4,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 144.34,
      "e": 147.43,
      "t": "もっと川上の言葉が分かれば、聞けるのにね。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 147.88,
      "e": 152.27,
      "t": "うん。だから、わたし、もっと川上の言葉を覚える。"
    },
    {
      "k": "m",
      "a": 153.47,
      "e": 156.13,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 156.73,
      "e": 162.03,
      "t": "数えた。小石、去年より少し多い。冬は、だいじょうぶ。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 162.48,
      "e": 170.99,
      "t": "ナワメのグツは、ぬれた手でもすべらなくて、ほんとに助かったよ。これから焼くグツには、みんなナワメをつけようよ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 171.44,
      "e": 174.18,
      "t": "ぼく、ナワメをつけるの、またやりたい。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 174.63,
      "e": 181.68,
      "t": "ハヤのかあさんは、とうちゃんのことを知っているみたい。でも、言葉が分からなくて、わけが聞けなかったの。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 182.13,
      "e": 190.09,
      "t": "ナカワシやナカビで覚えた川上の言葉を、寄り合いでみんなに話したい。わたしが行けない日も、だれかが分かるように。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 190.54,
      "e": 199.72,
      "t": "なんで寄り合いで？ ……そうか、ヨシがいなくなって、川上の言葉が分かるのはクリだけだからだね。それなら、わたしも覚える。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 200.17,
      "e": 216.06,
      "t": "グツを焼いたとき、炉のそばの土が、少し赤くなっていたの。焼くと赤くなる土が見つかれば、アカガケへ行かなくても、赤い色が作れる。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 216.51,
      "e": 220.83,
      "t": "トオカゲまでこげる、大きなウルも、まだあきらめていないんだけどなあ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 221.28,
      "e": 237.14,
      "t": "では決める。これから焼くグツには、ナワメをつける。川上で覚えた言葉は、年の終わりの寄り合いで、みんなに話す。天に届けるのは、焼くと赤くなる土が見つかるようにという、ミルの願いにする。"
    }
  ]
}