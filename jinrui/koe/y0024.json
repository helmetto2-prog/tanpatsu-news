{
  "schema": 1,
  "year": 24,
  "title": "24年目　トオカゲの年",
  "src": "y0024.mp3",
  "dur": 166.99,
  "hash": "696dfce155a867c8952525f7",
  "made": "2026-11-02 00:49",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.35,
      "t": "24年目　トオカゲの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.25,
      "e": 6.91,
      "t": "春・ハナの先の影"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 7.51,
      "e": 13.18,
      "t": "ナギかあさん、見て。トリシマのずっと向こう。あの青いの、雲じゃないよね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 13.63,
      "e": 16.3,
      "t": "雲じゃない。動かない。陸だ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 16.75,
      "e": 22.05,
      "t": "トリシマの南の浜にだけ、青い小石が上がってた。あの陸の方から来るのかなあ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 22.5,
      "e": 27.66,
      "t": "北風が三日吹いて、海がしずまった朝だけ見える。いつもは見えない。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 28.11,
      "e": 30.68,
      "t": "ぼくも、あっちから流れてきたのかなあ……。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 31.13,
      "e": 35.22,
      "t": "どこから来ても、おまえは浜で見つけた、わたしの子だ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 36.42,
      "e": 38.84,
      "t": "春・ワライヨの夜"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 39.44,
      "e": 45.32,
      "t": "みんな、聞いて。わたしとコナは、これから、いっしょに暮らします。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 45.77,
      "e": 49.23,
      "t": "シイばあとトチじいにも、聞いてもらいたかったんだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 49.68,
      "e": 54.89,
      "t": "まあまあ、やっと言ったねえ。ずっと前から、歌で分かってたよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 55.34,
      "e": 60.47,
      "t": "よし。住む所がいるな。小さい小屋の屋根を、ヨシとふき直すぞ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 60.92,
      "e": 66.86,
      "t": "今夜は、二人のためにも歌おうよ。とうちゃんとかあちゃんにも、聞こえるように。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 68.06,
      "e": 70.57,
      "t": "夏・浜の言い合い"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 71.17,
      "e": 75.84,
      "t": "魚を干し終わったら、ウルを二そう並べて、トオカゲまで行ってみたいんだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 76.29,
      "e": 80.41,
      "t": "なんで？ 何日こげば着くのかも、分からないんでしょ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 80.86,
      "e": 85.86,
      "t": "分からないから、行ってみたいんだよ。青い小石の来る所を、見てみたい。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 86.31,
      "e": 91.58,
      "t": "ソヨとオキは、まだ小さいんだよ。帰ってこなかったら、どうするの。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 92.03,
      "e": 93.81,
      "t": "ぼくは、帰ってくるよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 94.26,
      "e": 99.54,
      "t": "そう言って、海の向こうから来たのは、だれ？ わたしは行かせない。"
    },
    {
      "k": "m",
      "a": 100.74,
      "e": 103.39,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 103.99,
      "e": 108.08,
      "t": "数えた。冬の終わりの十日は、小石が一つも残らなかった。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 108.53,
      "e": 117.98,
      "t": "クリの実が嵐で落ちる年は、またある。たとえば、魚の群れが来た日に、食べる分より多くホシダナに干しておけば、冬の助けになる。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 118.43,
      "e": 123.72,
      "t": "そうだ。群れの来る日は、潮で分かる。来たら、みんなで干す。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 124.17,
      "e": 127.61,
      "t": "それと……ぼくは、いつかトオカゲまでウルを出したい。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 128.06,
      "e": 138.73,
      "t": "わたしは、今はいやだ。なんで行くのか、何日かかるのか、みんなで聞いてからにして。遠い陸へウルを出すのは、寄り合いで決めてからにしよう。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 139.18,
      "e": 143.56,
      "t": "ハジケマメは、この冬も袋のままだった。春にまける。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 144.01,
      "e": 150.2,
      "t": "ぼくは、干した魚が、春までくさらずにもてばいいと思う。そうしたら、冬の終わりも分けられる。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 150.65,
      "e": 165.99,
      "t": "決める。魚の群れが来た日は、食べる分より多くホシダナに干す。遠い陸へウルを出すのは、寄り合いで決めてからにする。天に届けるのは、コイシの、干した魚が春までくさらずにもちますようにという願いにする。"
    }
  ]
}