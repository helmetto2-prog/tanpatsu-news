{
  "schema": 1,
  "year": 44,
  "title": "44年目　ミネアテの年",
  "src": "y0044.mp3",
  "dur": 173.98,
  "hash": "c6f32b749012d1d04ca948ae",
  "made": "2026-11-23 00:47",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.57,
      "t": "44年目　ミネアテの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.47,
      "e": 6.59,
      "t": "春・ミネアテ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 7.19,
      "e": 13.15,
      "t": "見えたなあ……。海の上でふり返っても、クロミネの峰だけは、形が変わらなかったよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 13.6,
      "e": 21.62,
      "t": "行きはトオカゲの影を見る。帰りはクロミネの峰を見る。とうちゃん、そういうこと？"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 22.07,
      "e": 26.08,
      "t": "うん。帰る向きが分かれば、こわさは半分になるかなあ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 26.53,
      "e": 30.14,
      "t": "峰に舳先を当てて帰るんだね！ ミネアテだね！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 30.59,
      "e": 34.61,
      "t": "ミネアテ。オキにも、ナツにも教える。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 35.81,
      "e": 39.03,
      "t": "秋・三度目の帰りの潮"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 39.63,
      "e": 43.23,
      "t": "ねえね、ハナがどんどん左へ行く！ 潮に押されてる！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 43.68,
      "e": 51.51,
      "t": "あわてない。みんな、クロミネの峰に舳先を向けて！ 峰だけを見て、こいで！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 51.96,
      "e": 55.98,
      "t": "ソヨの言うとおりだなあ。ヒロカイを、そろえて深く入れよう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 56.43,
      "e": 56.91,
      "t": "……やる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 57.36,
      "e": 60.67,
      "t": "峰が、まっすぐ前に来た！ 入り江の口が見える！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 61.12,
      "e": 64.13,
      "t": "帰れる。ハナのけむりも見えた。"
    },
    {
      "k": "m",
      "a": 65.33,
      "e": 67.98,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 68.58,
      "e": 72.1,
      "t": "蓄え、八十かご。二年、余り。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 72.55,
      "e": 79.35,
      "t": "南の坂に移した若木は、八つとも雪の前まで葉をつけてた。春は、また日かげの芽を移したい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 79.8,
      "e": 94.57,
      "t": "トリシマまで三度渡った。静かな日、風のある日、帰りの潮が速い日。三度目は東へ流されかけたけど、クロミネの峰に舳先を向けて帰れた。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 95.02,
      "e": 100.51,
      "t": "三度渡ったんだなあ。来年の夏は、オオウルでトオカゲへ向けて出てみたいんだよなあ。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 100.96,
      "e": 105.35,
      "t": "なんで来年？ トオカゲまでは、トリシマの何倍も遠いよ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 105.8,
      "e": 118.64,
      "t": "だから、いきなりトオカゲまでは行かない。海の上で、クロミネの峰が見えなくなる前に引き返す。それなら、帰る向きをなくさない。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 119.09,
      "e": 124.7,
      "t": "ぼくも行く。少しずつ遠くへ出て、どこまでクロミネの峰が見えるか、確かめたい。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 125.15,
      "e": 132.6,
      "t": "峰が見えなくなるまでって、こわいね……。でも、見えているうちなら、帰ってこられるんだね。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 133.05,
      "e": 147.76,
      "t": "わたしは、川上の言葉を少しずつ覚えた。でも、ハヤのかあさんの話は、まだ分からない。とうちゃんの石のことを、ちゃんと聞きたい。天への願いは、ハヤのかあさんと言葉で話せますように、にしたい。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 148.21,
      "e": 172.98,
      "t": "では決める。オオウルは来年の夏、トオカゲへ向けて出してよい。ただし、海の上でクロミネの峰が見えなくなる前に、かならず引き返す。トリシマまで三度渡る掟は、もう済んだのでやめる。南の坂は、春にまたみんなでウツシギをする。天に届けるのは、ナカビでハヤのかあさんと言葉でちゃんと話せますようにという、クリの願いにする。"
    }
  ]
}