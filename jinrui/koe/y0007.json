{
  "schema": 1,
  "year": 7,
  "title": "7年目　クモスの年",
  "src": "y0007.mp3",
  "dur": 232.42,
  "hash": "e3d75e2bb3f7aa00ea6b002e",
  "made": "2026-10-23 15:20",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 2.9,
      "t": "7年目　クモスの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 3.8,
      "e": 6.27,
      "t": "春・薬草の弟子"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北きりたん",
      "a": 6.87,
      "e": 11.11,
      "t": "シイばあ、この葉っぱは？ ギザギザで、においがする。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 11.56,
      "e": 17.96,
      "t": "それは、おなかをこわした子にせんじる草だよ。ツル、よく見つけたね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北きりたん",
      "a": 18.41,
      "e": 25.02,
      "t": "じゃあ、おなかの草！……ねえ、シイばあ、ぜんぶの草の名前、わたしに教えて。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 25.47,
      "e": 32.23,
      "t": "いいよ。そのかわり、知らない草は口に入れないって、約束しておくれ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北きりたん",
      "a": 32.68,
      "e": 36.24,
      "t": "約束する！ わたし、シイばあの弟子になる。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 37.44,
      "e": 40.29,
      "t": "夏・クモスの初すくい"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 40.89,
      "e": 43.59,
      "t": "群れが来た。今だ。しずめろ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 44.04,
      "e": 48.75,
      "t": "すくうよ……重い！ 見て、ちっちゃいのも、ぜんぶ残ってる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 49.2,
      "e": 54.12,
      "t": "目を小さく結んだからです。この草の縄なら、細くしても破れない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北きりたん",
      "a": 54.57,
      "e": 57.56,
      "t": "クモの巣みたいに、すくうから……クモス！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 58.01,
      "e": 61.71,
      "t": "クモス、か。ヨシ、よく結んでくれた。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 62.16,
      "e": 64.61,
      "t": "去年の願いは、ナギのでしたから。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 65.81,
      "e": 68.06,
      "t": "夏・黒い石"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 68.66,
      "e": 74.93,
      "t": "大川の上手に、村のだれのでもない足あとがあった。たき火の跡に、これが落ちてた。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 75.38,
      "e": 79.73,
      "t": "見て見て！ 黒くて、つるつるで、ふちがすごくうすい。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 80.18,
      "e": 83.34,
      "t": "よその者か。何人だ。どっちへ行った。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 83.79,
      "e": 87.08,
      "t": "足あとは四つか五つ。川上へもどってた。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 87.53,
      "e": 89.96,
      "t": "……それは、川上の人の石です。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 90.41,
      "e": 92.34,
      "t": "知っているのか、ヨシ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 6,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 92.79,
      "e": 95.53,
      "t": "首の石と、同じ石だというだけです。"
    },
    {
      "k": "s",
      "s": 3,
      "a": 96.73,
      "e": 99.58,
      "t": "秋・はじめてのクリの実"
    },
    {
      "k": "l",
      "s": 3,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 100.18,
      "e": 106.64,
      "t": "じいちゃん！ ぼくの埋めたクリの木に、実がなったんだ。いちばん大きいの、じいちゃんに。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 1,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 107.09,
      "e": 112.3,
      "t": "……甘いのう。埋めた実が木になって、また実をつけるか。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 112.75,
      "e": 116.48,
      "t": "もっと埋めたら、丘のまわりがクリの木だらけになる？"
    },
    {
      "k": "l",
      "s": 3,
      "j": 3,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 116.93,
      "e": 121.81,
      "t": "なるじゃろう。わしは見られんが、コナの子らが見る。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 4,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 122.26,
      "e": 126.17,
      "t": "そんなこと言わずに、温かいうちにお食べ。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 5,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 126.62,
      "e": 133.39,
      "t": "とうちゃん、この子を抱いてみてよ。生まれたばかりの男の子。名前をつけてほしいんだ。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 6,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 133.84,
      "e": 139.29,
      "t": "……小さいが、重い。石のような子じゃ。コイシと呼べ。"
    },
    {
      "k": "m",
      "a": 140.49,
      "e": 143.15,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 143.75,
      "e": 149.13,
      "t": "最後に決めるのは長老だ。父がいない今、いちばん長く生きたのは母だ。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 149.58,
      "e": 155.41,
      "t": "わたしでいいのかい。……それなら、みんなの話をよく聞いてから決めるよ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 155.86,
      "e": 164.84,
      "t": "冬の蓄えが、オオイシ一つに少し足りないほど、足りなかった。実の少ない年は、クモスの魚と冬の貝を増やす。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 165.29,
      "e": 169.54,
      "t": "よその人に会ってみたい。あの黒い石のこと、聞いてみたい。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 169.99,
      "e": 175.09,
      "t": "向こうが何人で、何をしに来たか分からん。こっちから川上へは行くな。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 175.54,
      "e": 182.28,
      "t": "……川上の人が、みんなこわいわけではありません。会っても、こちらから先に手を出さないでください。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 182.73,
      "e": 189.35,
      "t": "ぼくのクリの木みたいに、拾った実を丘のまわりに埋めたい。何年かしたら、木になるから。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 189.8,
      "e": 197.28,
      "t": "まあまあ、おなかのすいた冬に実を埋めるのは惜しいけど、先の冬のためだね。コナの言うとおりにしようよ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 197.73,
      "e": 210.05,
      "t": "それとね、ネムリアナのしぶいカシの実は、シブニゲに何日もかかって、すぐには食べられなかったでしょう。しぶい実を、もっと早く、たくさん食べられるようにしたいよ。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 210.5,
      "e": 222.02,
      "t": "決めるよ。これからは、わたしが最後に決める。川上へは、こちらから行かない。よその人に会っても、先に手を出さない。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 222.47,
      "e": 231.42,
      "t": "秋には、拾ったクリの実をテノカズだけ、丘のまわりに埋めておくれ。願いは、アケビのにしよう。"
    }
  ]
}