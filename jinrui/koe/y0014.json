  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.29,
      "t": "14年目　ツキキザミの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.19,
      "e": 6.33,
      "t": "春・ツキキザミ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 6.93,
      "e": 12.18,
      "t": "ナギかあさん、今夜で刻み目がテノカズ三つになった。月が、また丸いよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 12.63,
      "e": 15.78,
      "t": "数えた。テノカズ三つと、少し。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p11",
      "n": "クリ",
      "v": "ずんだもん",
      "a": 16.23,
      "e": 19.15,
      "t": "月をきざむ棒だから、ツキキザミ！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 19.6,
      "e": 23.87,
      "t": "いい名だなあ。これを見れば、次の丸い月が前もって分かる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 24.32,
      "e": 28.21,
      "t": "分かるのは月だけだ。海は、その日にハナで見る。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 29.41,
      "e": 32.04,
      "t": "夏・川原のけんか"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 32.64,
      "e": 39.32,
      "t": "見て、また黒い石だ。ぼく、この石の取れる所が見たい。川を渡って行く。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 39.77,
      "e": 42.77,
      "t": "だめだ。掟だ。こっちからは渡らん。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 43.22,
      "e": 48.01,
      "t": "掟、掟って。じいちゃんだったら、見てこいって言ったよ！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 48.46,
      "e": 51.44,
      "t": "トチの名を出すな。お前一人のことじゃないんだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 51.89,
      "e": 54.94,
      "t": "たとえば、岩で言葉をたずねるやり方も……"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 55.39,
      "e": 59.01,
      "t": "もういい。ぼくがやる。ぼく一人で見つける。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 60.21,
      "e": 62.42,
      "t": "秋・かぶれた手"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 63.02,
      "e": 66.97,
      "t": "コナ、その手、真っ赤だよ。かゆいでしょ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 67.42,
      "e": 74.03,
      "t": "森の奥の沢で、白い汁の出る木にさわった。……暗かったけど、ぼく、行けたんだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 74.48,
      "e": 79.7,
      "t": "ユゲグサの汁で冷やそう。さわるとかぶれる木だから、カブレギだね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 80.15,
      "e": 85.36,
      "t": "汁は乾くと黒くなって、石みたいに固いんだ。何かに使えるかも。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 85.81,
      "e": 88.52,
      "t": "使う前に、まず手を治すの！"
    },
    {
      "k": "m",
      "a": 89.72,
      "e": 92.37,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 92.97,
      "e": 101.33,
      "t": "ツキキザミで数えると、静かな海の日は、丸い月のころに来ることが多い。次の丸い月まで、あと何夜か分かるんだ。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 101.78,
      "e": 108.44,
      "t": "それでも、出る日はハナで潮と風を見て決める。棒は、支度を始める日を教えるだけだ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 108.89,
      "e": 116.36,
      "t": "コナ、手はもういいかい。一人で森の奥へ行ったと聞いて、夜じゅう眠れなかったよ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 116.81,
      "e": 122.26,
      "t": "……ごめん。でも、沢があった。冷たい水と、白い汁の出る木。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 122.71,
      "e": 127.5,
      "t": "森の奥へ一人で黙って行くな。どこへ行くか、火の番に言ってから行け。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 127.95,
      "e": 132.45,
      "t": "カブレギの汁には、さわっちゃだめ。手が真っ赤になるよ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 132.9,
      "e": 142.61,
      "t": "たとえば、春に岩で川上の人に会えたら、黒い石の取れる所を、わたしが言葉でたずねてみます。渡らなくても、聞くことはできます。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 143.06,
      "e": 150.87,
      "t": "……うん。それなら、待つ。ぼくは、黒い石の取れる所を教えてもらえるように、天に頼みたい。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 151.32,
      "e": 155.65,
      "t": "まあまあ。兄さんもコナも、今夜は同じ火にあたろうよ。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 156.1,
      "e": 170.65,
      "t": "決めるよ。森の奥へ行く者は、行き先を火の番に言ってから行くこと。ツキキザミは、イソが続けて刻んでおくれ。黒い石のことは、春にヨシが岩でたずねる。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 171.1,
      "e": 174.6,
      "t": "天に届けるのは、コナの願いにしよう。"
    }
  ]
}