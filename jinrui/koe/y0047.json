  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.7,
      "t": "47年目　ナリナワの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.6,
      "e": 7.02,
      "t": "春・ワライヨの夜"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 7.62,
      "e": 12.05,
      "t": "丸い月の夜だ。ソヨ、コイシ、みんなの前へ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 12.5,
      "e": 17.02,
      "t": "……縄、もう一本なった。ソヨとぼくの手を、これで結ぶ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 17.47,
      "e": 21.17,
      "t": "ほどけない縄だね。かあさんが言ってたとおり。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 21.62,
      "e": 26.03,
      "t": "ホムラも、きっとここで笑ってるなあ。二人とも、いい顔だ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 26.48,
      "e": 29.2,
      "t": "ソヨとコイシは、今夜から連れ合いだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 29.65,
      "e": 34.48,
      "t": "おめでとう！ 二人のホリヤに、新しい寝ござを持っていくね！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 35.68,
      "e": 37.85,
      "t": "夏・ナリナワ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 38.45,
      "e": 42.95,
      "t": "ミルねえ、見て。この足あと、ゆうべのだ。木の根もとを掘ってる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 43.4,
      "e": 47.08,
      "t": "実が落ちたら、みんな食べられちゃうね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 47.53,
      "e": 48.83,
      "t": "……音で、追う。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 49.28,
      "e": 57.17,
      "t": "音？ あ、貝がらを縄に結んだら、カラカラ鳴るね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 57.62,
      "e": 62.26,
      "t": "木のあいだに張っておけば、イノシシがふれたら鳴る。番は、ぼくがする。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 62.71,
      "e": 64.35,
      "t": "縄は、ぼくがなう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 64.8,
      "e": 67.97,
      "t": "鳴る縄だから、ナリナワ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 69.17,
      "e": 72.02,
      "t": "冬・イソの青い小石"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 72.62,
      "e": 74.33,
      "t": "オキ、手を出してごらん。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 74.78,
      "e": 77.89,
      "t": "とうちゃんの青い小石……。いつも首にかけてたのに。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 78.34,
      "e": 83.96,
      "t": "浜に流れ着いた日から、ずっと持ってた。どこから来たのか、とうとう分からなかったなあ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 84.41,
      "e": 88.68,
      "t": "ぼくがさがす。トリシマの浜にも、同じ青い小石があったんだろ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 89.13,
      "e": 93.46,
      "t": "うん。ソヨ、ツキキザミの流木は、おまえにまかせるよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 93.91,
      "e": 99.37,
      "t": "まかせて。とうちゃんの刻み目の続きから、わたしが刻む。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 6,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 99.82,
      "e": 103.57,
      "t": "じゃあ、海の向こうの話を、もう一つしようかなあ……。"
    },
    {
      "k": "m",
      "a": 104.77,
      "e": 107.42,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 108.02,
      "e": 113.41,
      "t": "蓄え、九十七かご。ナツユキの森のクリの実が、たくさん入った。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 113.86,
      "e": 120.44,
      "t": "ナリナワは、来年も張りたい。クリの実が落ちるころは、毎晩二人で番をする。ワタリもいっしょに。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 120.89,
      "e": 125.16,
      "t": "ぼくも番をする。イノシシの足あとは、ナツがいちばんよく読むよ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 125.61,
      "e": 130.68,
      "t": "なら、狩りの頭はナツだね！ ホムラねえの森を守ったんだもん。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 131.13,
      "e": 134.56,
      "t": "……ぼくがやる。足あとを読んで、ちゃんと告げてから行く。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 135.01,
      "e": 142.99,
      "t": "来年の夏、ヤナさんが川上の村へ案内してくれる。わたしとミルで行きたい。帰る日は、しるしてから行くよ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 143.44,
      "e": 147.4,
      "t": "とうちゃんの村へ、ほんとに行けるんだね。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 147.85,
      "e": 154.73,
      "t": "とうちゃんのツキキザミは、わたしが続ける。潮読みも、オキと二人で。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 155.18,
      "e": 161.36,
      "t": "わたしの願いは、川上の村へ行く日に、川の水が低くありますように、がいいな。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 161.81,
      "e": 167.21,
      "t": "ぼくの願いは、とうちゃんの青い小石がどこから来たのか、分かりますように、がいい。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 167.66,
      "e": 189.26,
      "t": "では決める。クリの実が落ちるころは、ナツユキの森にナリナワを張り、夜は二人で番をする。狩りの頭はナツにする。来年の夏、クリとミルは、ヤナと決めた日に川上の村へ行く。天に届けるのは、とうちゃんの青い小石がどこから来たのか分かりますようにという、オキの願いにする。"
    }
  ]
}