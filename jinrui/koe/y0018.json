  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 4.02,
      "t": "18年目　流れ着いたかごの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.92,
      "e": 7.6,
      "t": "春・流れ着いたかご"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 8.2,
      "e": 13.21,
      "t": "ナギかあさん、見て。ハナの浜に、知らない編み方のかごが上がってた。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 13.66,
      "e": 21.45,
      "t": "目がななめに詰んでいます。わたしの編み方とも、川上の人々の編み方ともちがう。東から流れてきたのでしょう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 21.9,
      "e": 24.05,
      "t": "……中は海草だ。干してある。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "ずんだもん",
      "a": 24.5,
      "e": 27.94,
      "t": "潮にぬれてるのに、ぺちゃんこにならないね！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 28.39,
      "e": 34.43,
      "t": "母さんが、こうして岩の上に海草を干していた。小さいころ、かじったことがある。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 34.88,
      "e": 37.72,
      "t": "じゃあ、けむりの人たちは、やっぱり……。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 38.17,
      "e": 42.61,
      "t": "分からない。でも、海草なら、干潟にヤマホドある。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 7,
      "p": "p11",
      "n": "クリ",
      "v": "ずんだもん",
      "a": 43.06,
      "e": 45.7,
      "t": "干した海草だから、ホシモだね！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 46.9,
      "e": 49.41,
      "t": "秋・狩りの先頭"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 50.01,
      "e": 52.49,
      "t": "ホムラ、今日はおまえが先頭だ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 52.94,
      "e": 55.71,
      "t": "なんで？ 父さんが狩りの頭でしょ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 56.16,
      "e": 62.14,
      "t": "このごろ、坂でひざが言うことをきかん。獣の前で足が止まれば、みんなが危ない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 62.59,
      "e": 67.44,
      "t": "……分かった。足あとは、まだ新しい。沢の方へ下りてる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 67.89,
      "e": 72.3,
      "t": "ぼくは右の尾根から回る。シルヅケの先は、抜けないよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 72.75,
      "e": 75.67,
      "t": "行け。おれは、うしろから見ている。"
    },
    {
      "k": "m",
      "a": 76.87,
      "e": 79.52,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 80.12,
      "e": 86.84,
      "t": "ネムリアナも、カチガイのかごも、からになった。それでも、ホシモのかごが二つ残っている。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 87.29,
      "e": 93.85,
      "t": "夏になったら、ウルで東の岸づたいに行ってみたいなあ。岸の見える所なら、掟にも合うでしょ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 94.3,
      "e": 98.89,
      "t": "東の岸は何日もかかる。丘で待つ者は、いつまで待てばいい。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 99.34,
      "e": 106.09,
      "t": "ツキキザミがあるよ。出る日に、帰る日の刻み目にしるしをつけておく。その日までに、きっと帰る。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 106.54,
      "e": 114.64,
      "t": "わたしは丘に残る。ソヨとオキがいるし、狩りの先頭もあるから。帰る日には、ハナでけむりを上げて待ってる。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 115.09,
      "e": 119.63,
      "t": "狩りの先頭は、ホムラにまかせる。おれは、うしろから見る。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 120.08,
      "e": 130.85,
      "t": "まあまあ、食べ物のことも忘れないでよ。二年続けて実が少なかった。天には、次の秋に木の実がたくさん落ちますように、と願いたいな。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 131.3,
      "e": 158.16,
      "t": "決めるよ。遠くへ出る者は、出る日にツキキザミに帰る日のしるしをつけてから行くこと。東の岸へは、夏、ホシモを干し終えてから、ウルを二つ並べて行くこと。狩りの先頭は、カシの言うとおりホムラにまかせる。天に届けるのは、アケビの、次の秋に木の実がたくさん落ちますようにという願いにしよう。"
    }
  ]
}