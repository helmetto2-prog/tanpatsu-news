  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.35,
      "t": "11年目　ユゲグサの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.25,
      "e": 6.28,
      "t": "春・ユゲグサ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 6.88,
      "e": 12.01,
      "t": "シイばあ、のどがすうっとする。ゆげに、草のにおいがする！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 12.46,
      "e": 19.57,
      "t": "あったかい汁が、冷えたのどにいいんだよ。どの草が落ちたんだい、見せておくれ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 20.02,
      "e": 26.38,
      "t": "これ。道ばたの、広い葉っぱの草。ゆげの出る草だから……ユゲグサ！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 26.83,
      "e": 31.35,
      "t": "まあまあ、グツは実を煮るだけじゃないんだね。歌いたくなっちゃう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 31.8,
      "e": 38.33,
      "t": "川上の子にも、これを飲ませたい。でも、あの人たちはグツを持ってないんだよね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 38.78,
      "e": 44.42,
      "t": "なら、グツごと置こうよ。約束の一つ、わたしがいちばんいいのを焼くよ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 45.62,
      "e": 47.95,
      "t": "夏・ハナの先"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 48.55,
      "e": 53.26,
      "t": "ほら、島が近いだろう。ナツユキの森から見たときより、ずっと。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 53.71,
      "e": 58.95,
      "t": "鼻みたいにつき出てるから、ここはハナだね。……イソ、行きたいんでしょ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 59.4,
      "e": 66.07,
      "t": "行きたいなあ。でも、今日はここまで。ナギかあさんと、岸の見える所までって約束したから。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 66.52,
      "e": 69.08,
      "t": "なんで、そんなにがまんできるの？"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 69.53,
      "e": 72.65,
      "t": "丘で、けむりを待っててくれる人がいるからかなあ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 73.85,
      "e": 76.38,
      "t": "秋・小さいホリヤ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 76.98,
      "e": 81.75,
      "t": "ナギかあさん、カシとうさん。ホムラと、二人のホリヤで暮らしたいんだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 82.2,
      "e": 84.22,
      "t": "……浜ではなく、丘にか。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 84.67,
      "e": 89.1,
      "t": "うん。丘なら、ホムラの走る音も、みんなのけむりも近い。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 89.55,
      "e": 94.49,
      "t": "古いホリヤは柱が細い。雪で鳴る。直すなら、手を貸すぞ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 94.94,
      "e": 98.0,
      "t": "とうちゃん、それって、いいってこと？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 98.45,
      "e": 99.13,
      "t": "そうだ。"
    },
    {
      "k": "m",
      "a": 100.33,
      "e": 102.99,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 103.59,
      "e": 110.66,
      "t": "せきの子、走ってた！ ユゲグサが川を渡ったんだね。秋にも、グツを置こうよ。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 111.11,
      "e": 118.49,
      "t": "黒い石で、ササリボの先がみんなの分そろった。……あの石が、川上のどこで取れるのか見てみたい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 118.94,
      "e": 123.82,
      "t": "ハナの先からなら、島がすぐそこに見える。ウルで、渡ってみたいなあ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 124.27,
      "e": 132.6,
      "t": "岸の見えない所は、潮も風も読めない。ウルで出るのは、わたしが潮と風を見た日だけ。岸の見える所まで。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 133.05,
      "e": 137.17,
      "t": "ウルは一つしかない。島へ行くなら、もっと強いウルがいる。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 137.62,
      "e": 143.96,
      "t": "たとえば、水をかく板を二人で持てば、もっと速く進めます。小さく試してみましょう。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 144.41,
      "e": 156.02,
      "t": "決めるよ。ウルで出るのは、ナギが潮と風を見た日だけ。行くのは岸の見える所まで。秋にも、グツとユゲグサを岩に置こう。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 156.47,
      "e": 164.89,
      "t": "天に届けるのは、イソの願いにしよう。わたしたちだけで決めるには、海は大きすぎるからね。"
    }
  ]
}