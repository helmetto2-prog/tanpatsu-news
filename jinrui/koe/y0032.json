  "title": "32年目　ナカビの年",
  "src": "y0032.mp3",
  "dur": 164.83,
  "hash": "4c5eee13417382a1a22fc706",
  "made": "2026-11-11 00:47",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.45,
      "t": "32年目　ナカビの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.35,
      "e": 7.31,
      "t": "春・浅瀬のまん中の火"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 7.91,
      "e": 11.93,
      "t": "とうちゃん、見て。浅瀬のまん中に、砂地が出てる！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 12.38,
      "e": 19.09,
      "t": "どちらの岸でもない所だね。たとえば、あそこで火をたけば、向こうの岸に入ったことにはならない。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 19.54,
      "e": 21.21,
      "t": "ハヤ、来てくれるかな。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 21.66,
      "e": 27.39,
      "t": "小さく試してみよう。先に手を出さない掟がある。火をつけて、座って待とう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 27.84,
      "e": 30.73,
      "t": "ハヤが渡ってくる！ 火のそばに座ったよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 31.18,
      "e": 34.69,
      "t": "同じ火だね。まん中の火だから、ナカビって呼ぶ！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 35.89,
      "e": 38.46,
      "t": "夏・三本の縄"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 39.06,
      "e": 44.88,
      "t": "コイシ、三本をより合わせてごらん。たとえば、ねじる向きを一本ずつ逆にする。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 45.33,
      "e": 46.0,
      "t": "……こう？"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 46.45,
      "e": 49.53,
      "t": "そうだ。柱に巻いて、引っぱってごらん。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 49.98,
      "e": 52.81,
      "t": "切れない。とうちゃんの縄と、同じ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 53.26,
      "e": 56.45,
      "t": "もう、わたしが結び目を確かめなくてもいいね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 56.9,
      "e": 58.24,
      "t": "……まだ、見てて。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 59.44,
      "e": 62.26,
      "t": "秋・黒い石のかけら"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 62.86,
      "e": 68.92,
      "t": "クリ、これを持っていなさい。わたしが川上から一人で来たとき、首にかけていた石だ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 69.37,
      "e": 71.17,
      "t": "とうちゃんの大事な石でしょう。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 71.62,
      "e": 78.98,
      "t": "だからだよ。わたしは川上から来て、この村の者になった。ハヤとクリのあいだに、この石があればいい。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 79.43,
      "e": 83.78,
      "t": "とうちゃんは、ずっと村の者だよ。みんな、そう思ってる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 84.23,
      "e": 87.46,
      "t": "……そうか。そう言ってもらえると、うれしいね。"
    },
    {
      "k": "m",
      "a": 88.66,
      "e": 91.32,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 91.92,
      "e": 96.02,
      "t": "数えた。小石が残る。冬の終わりまで、足りる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 96.47,
      "e": 102.41,
      "t": "長老がいない。掟のとおり、みんながうなずける人を決めよう。なんで待つの？"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 102.86,
      "e": 106.85,
      "t": "アケビかなあ。いつも、みんなの仲をまるくしてくれるからなあ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 107.3,
      "e": 112.37,
      "t": "わたしも、かあさんがいいと思う！ みんな、うなずいてるね！"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 112.82,
      "e": 118.38,
      "t": "まあまあ、わたしでいいなら、やるよ。みんなが笑っていられるように決めるね。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 118.83,
      "e": 124.56,
      "t": "ナカビの砂地は、雨のあとは沈むんだ。水の低い日に、二人で行くことにしたいなあ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 125.01,
      "e": 129.37,
      "t": "わたしも、一人では行かない。いつも、だれかと二人で行く。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 129.82,
      "e": 140.5,
      "t": "浜でナミノコを煮ると、たきぎがすぐなくなる。ナミノコを煮るたきぎが浜でたくさん見つかるように、天にお願いしたい。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 140.95,
      "e": 145.65,
      "t": "ぼくは……とうちゃんみたいな縄を、ずっとなえるように、願いたい。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 146.1,
      "e": 163.83,
      "t": "みんな、ありがとう。では決める。ナカビの砂地へは、水の低い日に二人で行く。天に届けるのは、ナミノコを煮るたきぎが浜でたくさん見つかるようにという、ソヨの願いにする。コイシの縄は、もうコイシの手が覚えているよ。"
    }
  ]
}