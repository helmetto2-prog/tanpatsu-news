{
  "schema": 1,
  "year": 42,
  "title": "42年目　ヒアテとオオウルの年",
  "src": "y0042.mp3",
  "dur": 201.16,
  "hash": "7cfeb057e60cb4e92f879205",
  "made": "2026-11-21 00:49",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 4.01,
      "t": "42年目　ヒアテとオオウルの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.91,
      "e": 7.71,
      "t": "春・日の当たるクリの木"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 8.31,
      "e": 13.33,
      "t": "見て見て！ 雪で折れた木のとなりのクリの木だけ、花がこんなに白い。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 13.78,
      "e": 18.85,
      "t": "なんで、あの木だけなの？ 同じ丘の、同じクリの木なのに。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 19.3,
      "e": 27.75,
      "t": "まわりの木がなくなって、日がまっすぐ当たってる。ぼくが一年目に埋めたクリの実の木も、日かげの枝には花が少ない。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 28.2,
      "e": 29.72,
      "t": "……まわり、払う。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 30.17,
      "e": 36.77,
      "t": "うん。実をくれる木は切らないで、細い木と草だけ払う。日を当てるから、ヒアテだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 37.22,
      "e": 40.36,
      "t": "それなら掟にもそむかないね。やってみて。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 41.56,
      "e": 44.77,
      "t": "春・浅瀬を渡ってきた犬"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 45.37,
      "e": 49.66,
      "t": "コイシにいさん、浅瀬から犬が渡ってきた。前の足を引きずってる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 50.11,
      "e": 51.49,
      "t": "……魚、やる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 51.94,
      "e": 56.03,
      "t": "ホエが、においをかいで、となりに寝ころんだよ。怒ってない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 56.48,
      "e": 61.9,
      "t": "ヒヤシバで足を包んであげよう。川をワタってきたから、ワタリだね！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 62.35,
      "e": 64.83,
      "t": "ワタリ。……ホエと、寝ていい。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 66.03,
      "e": 68.78,
      "t": "夏・スナカゲのけむり"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 69.38,
      "e": 74.65,
      "t": "とうちゃん、ナミノコを煮ない日なのに、けむりが上がってた。……この丸木、なに？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 75.1,
      "e": 80.94,
      "t": "見つかっちゃったかなあ。大きなウルにしたいんだ。何人も乗れて、トオカゲまで行けるくらいの。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 81.39,
      "e": 87.78,
      "t": "とうちゃん、ずっとこれをやってたの？ なんで、だれにも言わなかったの。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 88.23,
      "e": 95.55,
      "t": "言ったら、かあさんに止められると思ったんだよなあ。年寄りになって、こげなくなる前に、作っておきたかったんだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 96.0,
      "e": 100.5,
      "t": "かくしても、けむりは丘から見えるよ。ぼくは、かあさんに話す。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 100.95,
      "e": 103.21,
      "t": "……そうだなあ。オキの言うとおりだ。"
    },
    {
      "k": "s",
      "s": 3,
      "a": 104.41,
      "e": 106.87,
      "t": "冬・炉ばたの二人"
    },
    {
      "k": "l",
      "s": 3,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 107.47,
      "e": 111.42,
      "t": "なんで、わたしに言わなかったの。止めると思った？"
    },
    {
      "k": "l",
      "s": 3,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 111.87,
      "e": 118.09,
      "t": "うん。ホムラは、なんでって聞いて、わけが足りなかったら、きっと行かせないと思ったんだよなあ。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 118.54,
      "e": 124.29,
      "t": "行かせないかどうかは、聞いてから決める。わたしは、だまって行かれるほうがこわい。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 124.74,
      "e": 128.31,
      "t": "……ごめんなあ。ウルのことは、寄り合いでみんなに話すよ。"
    },
    {
      "k": "m",
      "a": 129.51,
      "e": 132.17,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 132.77,
      "e": 141.02,
      "t": "だまっていて、ごめんなあ。スナカゲで、大きな丸木をくりぬいてる。何人も乗れる、大きなウル、オオウルにしたいんだ。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 141.47,
      "e": 151.72,
      "t": "なんでイソがかくしたのか、聞いた。止められると思ったからだって。だから、遠くへ行く支度は、かくさないで、寄り合いで話すことにしたい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 152.17,
      "e": 155.96,
      "t": "ぼくも、オオウルの丸木をこがして、かき出すのを手伝いたい。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 156.41,
      "e": 165.74,
      "t": "トオカゲへ行くなら、潮と風はわたしが読む。でも、トリシマの先の海は、まだだれも知らない。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 166.19,
      "e": 169.85,
      "t": "実、たくさん。蓄え、六十四かご。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 170.3,
      "e": 177.16,
      "t": "日を当てたクリの木だけ、こんなに実をつけた。丘のまわりにも、日の当たるクリの木をふやしたい。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 177.61,
      "e": 182.0,
      "t": "ハヤが、ワタリを村の犬にしていいって、しぐさで言ってくれたよ！"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 182.45,
      "e": 200.16,
      "t": "では決める。遠くへ行く支度は、かくさずに寄り合いで話す。オオウルは、みんなで作る。トオカゲへ出すかどうかは、オオウルができてから、寄り合いで決める。天に届けるのは、日の当たるクリの木がもっとふえますようにという、コナの願いにする。"
    }
  ]
}