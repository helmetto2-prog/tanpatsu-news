  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.7,
      "t": "28年目　ハコビアミの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.6,
      "e": 7.0,
      "t": "夏・ぬれた坂で"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 7.6,
      "e": 11.65,
      "t": "……足が、言うことを聞かん。先に行け、ホムラ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 12.1,
      "e": 16.81,
      "t": "なんで置いていけるの？ とうちゃんを置いて帰るなんて、できないよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 17.26,
      "e": 18.51,
      "t": "縄、ある。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 18.96,
      "e": 25.15,
      "t": "コイシ、その縄を、この二本の木のあいだに渡して。何度も、目をこまかく。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 25.6,
      "e": 28.17,
      "t": "やる。とうちゃんに習った結び方。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 28.62,
      "e": 30.31,
      "t": "……すまん。重いぞ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 30.76,
      "e": 34.24,
      "t": "重いのは知ってる。だから、二人で運ぶんだ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 35.44,
      "e": 37.68,
      "t": "夏・ぬらした葉"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 38.28,
      "e": 42.75,
      "t": "カシおじ、じっとしてて。イシイズミの水で洗うよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 43.2,
      "e": 45.08,
      "t": "これくらい、なんでもない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 45.53,
      "e": 51.57,
      "t": "なんでもなくないよ！ このヒヤシバは、ぬらして包むと、ほてりが引くんだね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 52.02,
      "e": 56.12,
      "t": "足首が熱を持っている。三晩は、丘を下りない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 56.57,
      "e": 58.75,
      "t": "……ナギがそう言うなら、そうする。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 59.95,
      "e": 62.35,
      "t": "秋・浅瀬の岩"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 62.95,
      "e": 66.44,
      "t": "とうちゃん、見て。向こうの人、手をふってる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 66.89,
      "e": 73.63,
      "t": "川上の言葉で、『よい葉だ』と言っている。たとえば、ヒヤシバのことを聞いているのかもしれない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 74.08,
      "e": 78.31,
      "t": "ヒヤシバ！ ヒ、ヤ、シ、バ！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 78.76,
      "e": 80.86,
      "t": "ほら、まねをして笑っている。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 81.31,
      "e": 89.37,
      "t": "笑うと、目が細くなる人だね。……とうちゃん、川上の言葉で『また来る』って、なんて言うの？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 89.82,
      "e": 93.77,
      "t": "小さく試してみよう。まず、あいさつの言葉からだ。"
    },
    {
      "k": "m",
      "a": 94.97,
      "e": 97.63,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 98.23,
      "e": 102.7,
      "t": "数えた。干し肉は少ない。でも、冬の終わりまで足りる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 103.15,
      "e": 110.6,
      "t": "とうちゃんは、ぬれた坂ですべった。年寄りが森の坂へ行くときは、若い者と組んで行くことにしてほしい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 111.05,
      "e": 113.09,
      "t": "おれは、まだ一人で歩ける。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 113.54,
      "e": 118.34,
      "t": "なんで一人がいいの？ 一人だったら、だれがとうちゃんを運んだの？"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 118.79,
      "e": 125.22,
      "t": "たとえば、コイシの縄がなければ、ハコビアミはできなかった。二人でいたから、運べたんだ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 125.67,
      "e": 131.0,
      "t": "まあまあ、兄さん。組んで行けば、帰り道の話し相手もいるよ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 131.45,
      "e": 133.5,
      "t": "……ナギが決めるなら、従う。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 133.95,
      "e": 139.17,
      "t": "ハコビアミは、すぐ出せるように、物置の梁にかけておこうよ！"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 139.62,
      "e": 147.1,
      "t": "わたし、浅瀬の向こうの人と、言葉を交わせるようになりたい。ヒヤシバの名を、あの人はまねして笑ったんだ。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 147.55,
      "e": 151.1,
      "t": "あら、クリ。歌うみたいな声で言うねえ。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 151.55,
      "e": 165.31,
      "t": "決める。年寄りが森の坂へ行くときは、若い者と組んで行く。ハコビアミは物置の梁にかけておく。天に届けるのは、浅瀬の向こうの人と言葉を交わせますようにという、クリの願いにする。"
    }
  ]
}