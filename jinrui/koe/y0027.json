{
  "schema": 1,
  "year": 27,
  "title": "27年目　ヌリカサネの年",
  "src": "y0027.mp3",
  "dur": 200.22,
  "hash": "92e2107f19752a2af5adaf46",
  "made": "2026-11-06 00:48",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.72,
      "t": "27年目　ヌリカサネの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.62,
      "e": 7.31,
      "t": "春・弟子にしてください"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 7.91,
      "e": 16.03,
      "t": "コナ、見て。このへらの先、川原の黒い物と同じ光り方。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 16.48,
      "e": 22.1,
      "t": "それ、シルヅケのときのへらだ。汁をつけては置いて、何度も使ったんだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 22.55,
      "e": 29.27,
      "t": "柄の方はざらざら。何度も重なった所だけ、光ってる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 29.72,
      "e": 37.63,
      "t": "わたしに、カブレギの汁の扱い方を教えて。光る物を作りたい。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 38.08,
      "e": 45.99,
      "t": "いいよ。ぼくもトチじいに弟子入りしたとき、こんなふうに頼んだんだ。最初は、手を葉で包むところからだ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 46.44,
      "e": 52.54,
      "t": "かぶれたら、すぐわたしのところに来るんだよ！ 汁は、こわい子なんだからね。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 53.74,
      "e": 56.15,
      "t": "夏・ハネギを塗る"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 56.75,
      "e": 61.46,
      "t": "わたしのハネギに塗ってみて。雨にぬれると、しなりが弱くなるんだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 61.91,
      "e": 68.9,
      "t": "うすく、うすく。指の先ほどだけ、のばす。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 69.35,
      "e": 73.34,
      "t": "なんでそんなにうすく塗るの？ 厚く塗れば一度ですむじゃない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 73.79,
      "e": 79.98,
      "t": "厚く塗ると、しわになって乾かないんだ。シルヅケのときに、それで一度だめにした。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 80.43,
      "e": 88.19,
      "t": "乾いたら、また塗る。へらの先みたいに、何度も重ねる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 88.64,
      "e": 92.1,
      "t": "そういうわけか。分かった。乾くまで待つよ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 93.3,
      "e": 95.66,
      "t": "秋・光るハネギ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 96.26,
      "e": 100.06,
      "t": "長雨のあとだ。ハネギが弱っていないか、見せてみろ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 100.51,
      "e": 104.32,
      "t": "ほら、とうちゃん。雨のあとでも、ちゃんとしなる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 104.77,
      "e": 108.05,
      "t": "……強いな。それに、炉の火みたいに光っている。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 108.5,
      "e": 117.02,
      "t": "五回、塗り重ねた。まだ、川原の黒い物ほどは光ってない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 117.47,
      "e": 119.91,
      "t": "十分だ。行くぞ、ホムラ。"
    },
    {
      "k": "m",
      "a": 121.11,
      "e": 123.77,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 124.37,
      "e": 131.45,
      "t": "数えた。クリの実がいつもどおり実って、ハジケマメも増えた。冬の終わりまで足りて、少し残る。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 131.9,
      "e": 139.64,
      "t": "ミルが塗ったハネギは、長雨のあとでもしなった。わたしのハネギだけじゃなくて、カシとうちゃんのハネギにも塗ってほしい。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 140.09,
      "e": 152.02,
      "t": "うすく塗って、乾かして、また塗る。五回で光った。もっと重ねたら、もっと光ると思う。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 152.47,
      "e": 160.65,
      "t": "でも、乾く前の汁にさわると、ミルみたいに手が真っ赤になるんだよ！ ナツやオキがさわったら大変だね！"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 161.1,
      "e": 167.74,
      "t": "汁を塗った物は、乾くまで高い所に置いて、子どもにさわらせないことにしようよ！"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 168.19,
      "e": 173.7,
      "t": "まあまあ、それならみんな安心だね。オキは光る物にすぐ手をのばすからねえ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 174.15,
      "e": 182.39,
      "t": "それから、かぶれた手がすぐ治る草があればいいのに。今の薬草の湯では、冷やすことしかできないんだ。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 182.84,
      "e": 186.5,
      "t": "ツルがそう言うなら、それがいちばん困ってることなんだろうなあ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 186.95,
      "e": 199.22,
      "t": "決める。汁を塗った物は、乾くまで高い所に置き、子どもにさわらせない。天に届けるのは、ツルの、かぶれた手がすぐ治る草が見つかりますようにという願いにする。"
    }
  ]
}