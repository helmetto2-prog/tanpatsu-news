{
  "schema": 1,
  "year": 35,
  "title": "35年目　モドラズの年",
  "src": "y0035.mp3",
  "dur": 177.22,
  "hash": "7a2c1f161476ca842b4e4f32",
  "made": "2026-11-14 00:48",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.59,
      "t": "35年目　モドラズの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.49,
      "e": 7.51,
      "t": "夏・川原のふしぎなかご"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 8.11,
      "e": 14.07,
      "t": "見て見て！ 流木に、つるのかごが引っかかってる。中で魚がはねてるよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 14.52,
      "e": 18.81,
      "t": "ほんとだ。かごの口が、内側にすぼまってるね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 19.26,
      "e": 23.29,
      "t": "魚は、入れても出られないんだ。……だれが編んだんだろう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 23.74,
      "e": 30.96,
      "t": "つるの編み方が、うちのかごとちがう。川上から流れてきたんだと思う。ハヤの群れの人たちのかごかな。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 31.41,
      "e": 35.29,
      "t": "入ったら、もどらないかご。モドラズって呼ぼう！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 35.74,
      "e": 39.05,
      "t": "モドラズか。ぼくも、このかごを編んでみる。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 40.25,
      "e": 42.65,
      "t": "秋・いっしょに編む"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 43.25,
      "e": 48.14,
      "t": "かごの口が、どうしても内側に曲がらない。すぐにほどけてしまう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 48.59,
      "e": 55.75,
      "t": "まあまあ、ちょっと貸してごらん。ヨシはね、かごの口を、こうやって内へ折りこんでいたよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 56.2,
      "e": 62.75,
      "t": "……アケビおば。マメエリのとき、ぼくは大きい粒をゆずらなかった。言いすぎたと思ってる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 63.2,
      "e": 70.92,
      "t": "わたしもだよ。でも、あの大きい粒を残したから、今年みたいな年でも、まく豆があるんだよね。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 71.37,
      "e": 74.53,
      "t": "じゃあ、このモドラズは、二人で編もう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 74.98,
      "e": 78.27,
      "t": "いいね。編みながら、歌でもうたおうよ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 79.47,
      "e": 81.83,
      "t": "秋・ナカビの火"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 82.43,
      "e": 85.25,
      "t": "クリねえ、水が引いた。砂地が出てる！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 85.7,
      "e": 89.47,
      "t": "春から、ずっと待ってた日だね。砂地で火をたこう。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 89.92,
      "e": 93.59,
      "t": "向こう岸から、ハヤが来る。……うしろに、もう一人いる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 94.04,
      "e": 97.48,
      "t": "年上の女の人だ。ハヤの、かあさんかな。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 97.93,
      "e": 101.16,
      "t": "あの人、クリねえの首の石を、じっと見てる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 101.61,
      "e": 106.31,
      "t": "……これはね、とうちゃんの石。とうちゃんは、川上から来た人なの。"
    },
    {
      "k": "m",
      "a": 107.51,
      "e": 110.17,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 110.77,
      "e": 115.67,
      "t": "数えた。小石、去年より減った。でも、冬はこせる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 116.12,
      "e": 127.92,
      "t": "モドラズには、毎朝魚が入る。でも、小さい魚まで食べたら、来年の魚がいなくなる。モドラズに入った小さい魚は、川に返そう。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 128.37,
      "e": 136.72,
      "t": "なんで返すの？ ……そうか、大きくなって、またモドラズに入りに来るからだね。マメエリと同じだ。わかった。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 137.17,
      "e": 144.0,
      "t": "ナカビで、ハヤのかあさんみたいな人に会えた。その人は、とうちゃんの黒い石を、じっと見てたの。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 144.45,
      "e": 155.08,
      "t": "ヒイシは、まだ手のひらに乗るだけ。ヒイシのたくさんある所が見つかるように、天にお願いしたい。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 155.53,
      "e": 161.82,
      "t": "海の向こうのトオカゲにも、いつか行ってみたいなあ。でも今年は、ミルのヒイシの願いでいいかなあ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 162.27,
      "e": 176.22,
      "t": "まあまあ、みんなありがとう。では決める。モドラズに入った小さい魚は、川に返す。天に届けるのは、ヒイシのたくさんある所が見つかるようにという、ミルの願いにする。"
    }
  ]
}