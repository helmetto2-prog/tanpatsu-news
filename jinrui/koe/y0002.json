{
  "schema": 1,
  "year": 2,
  "title": "2年目　シブニゲの年",
  "src": "y0002.mp3",
  "dur": 205.13,
  "hash": "fb5e005d4d4b4e74d5baf1a3",
  "made": "2026-10-24 10:06",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 2.91,
      "t": "2年目　シブニゲの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 3.81,
      "e": 6.32,
      "t": "春・しぶみが逃げた"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 6.92,
      "e": 12.41,
      "t": "ねえ、みんな食べてみて。湧き水に何日もひたしておいたカシの実だよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北きりたん",
      "a": 12.86,
      "e": 16.29,
      "t": "……しぶくない！ しぶいのが、お水に逃げてった！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 16.74,
      "e": 24.52,
      "t": "たとえば、くだいて小さくすれば、しぶみはもっと早く逃げるのかもしれない。かごの目を、もっとこまかく編んでみよう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 24.97,
      "e": 32.4,
      "t": "これなら子どものおなかにもやさしいね。でも冷たい水だよ。手を冷やしすぎないでおくれ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 32.85,
      "e": 37.61,
      "t": "シブニゲ、か。ツルのつける名前は、いつもぴったりだね。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 38.81,
      "e": 41.73,
      "t": "秋・足あとをたどって"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 42.33,
      "e": 48.35,
      "t": "父さん！ やっぱりここだ。イノシシの足あとと、父さんの足あとが重なってた。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 48.8,
      "e": 52.01,
      "t": "……ホムラか。足をくじいた。立てん。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 52.46,
      "e": 57.94,
      "t": "なんで一人で来たの？ 待ってて。丘まで走って、みんなを呼んでくる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 58.39,
      "e": 59.99,
      "t": "暗くなる前に戻れるか。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 60.44,
      "e": 62.54,
      "t": "わたしの足なら、すぐだよ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 63.74,
      "e": 66.68,
      "t": "秋・枕もとの言い合い"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 67.28,
      "e": 72.26,
      "t": "たとえば、獣にあそこまで近づかなくても、とれるやり方があるはずだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 72.71,
      "e": 78.06,
      "t": "おまえはイノシシの前に立ったことがあるのか。やりは、近づかなければ届かんのだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 78.51,
      "e": 82.01,
      "t": "だから、近づかずにすむ物を考えようと言っている。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 82.46,
      "e": 85.82,
      "t": "口で言うのはたやすい。わなでイノシシがとれるか。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 86.27,
      "e": 92.15,
      "t": "まあまあ。兄さんは今は寝てて。ヨシも、続きは足が治ってからにしよう。"
    },
    {
      "k": "m",
      "a": 93.35,
      "e": 96.01,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 96.61,
      "e": 107.84,
      "t": "数えた。秋にためたかごは、オオイシ三つと小石六つ。冬に食べたのは、オオイシ三つと小石三つ。残りは小石三つ。ぎりぎりだった。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 108.29,
      "e": 116.11,
      "t": "シブニゲしたカシの実がなかったら、足りなかったね。来年の秋も、カシの実をくだいて湧き水にひたそうよ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 116.56,
      "e": 121.17,
      "t": "あれなら子どももおなかをこわさない。わたしも手伝うよ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 121.62,
      "e": 134.04,
      "t": "約束どおり、足あとをテノカズ読み分けた。シカ、イノシシ、ウサギ、タヌキ、キツネ、テン、アナグマ、サル、キジ、カモ。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 134.49,
      "e": 143.2,
      "t": "父さんを見つけたのも、足あとを読んだからだよ。男か女かじゃなくて、足あとが読めるかで、狩りに行く人を決めて。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 143.65,
      "e": 154.38,
      "t": "……ホムラがいなければ、おれは森で夜を明かしていた。足あとを読む者、ヨミテは狩りに要る。ただし、獣の前にだれが立つかは、狩りの頭が決める。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 154.83,
      "e": 159.94,
      "t": "たとえば、近づかずに獣に届く物があれば、前に立つ者もこわくない。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 160.39,
      "e": 162.53,
      "t": "それができるなら、見せてみろ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 162.98,
      "e": 169.71,
      "t": "決める。シブニゲしたカシの実は、これからも冬の蓄えにする。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 170.16,
      "e": 185.14,
      "t": "狩りの掟は変える。大きな獣の狩りには、足あとを読み分けられる者が行く。男か女かでは決めん。前に立つ者は、狩りの頭が決めよ。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 185.59,
      "e": 192.54,
      "t": "願いは、近づかなくても獣に届く物がほしい。もう、牙の前で足をくじくのはごめんだ。"
    },
    {
      "k": "ml",
      "j": 11,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 192.99,
      "e": 195.4,
      "t": "入り江の向こうも、まだ見てみたいなあ。"
    },
    {
      "k": "ml",
      "j": 12,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 195.85,
      "e": 204.13,
      "t": "今年、天に届けるのは、カシの願いにする。けがをして戻った者の願いじゃ。"
    }
  ]
}