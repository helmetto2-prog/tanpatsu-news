  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 4.35,
      "t": "21年目　シミアナと見送りの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 5.25,
      "e": 7.3,
      "t": "春・シミアナ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 7.9,
      "e": 14.16,
      "t": "ここだよ。シカが前足で砂をかいたら、水がたまったんだ。なめてみたら、しょっぱくなかった。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 14.61,
      "e": 24.41,
      "t": "去年しょっぱかったのは、海の側のふもとでした。たとえば、丘の側なら、雨の水が砂にたまっているのかもしれない。小さく掘ってみよう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 24.86,
      "e": 25.3,
      "t": "掘る。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 25.75,
      "e": 28.82,
      "t": "あれ、砂がくずれて、水がにごっちゃうなあ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 29.27,
      "e": 34.19,
      "t": "ハマホリヤのかべと同じです。ヨシの束を輪に立てて、砂を止めましょう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 34.64,
      "e": 40.88,
      "t": "……ひと晩おいたら、すんでる！ 砂からしみてくる水の穴だから、シミアナだね！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 42.08,
      "e": 44.25,
      "t": "夏・ツチブルイ"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "小夜/SAYO",
      "a": 44.85,
      "e": 48.49,
      "t": "ホエがほえてる。……あっ、地面がぶるぶるした！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 48.94,
      "e": 53.52,
      "t": "子どもは広い所へ！ ソヨ、オキ、こっち！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 53.97,
      "e": 58.15,
      "t": "みんな、無事か。……湧き水の上の坂が、くずれたな。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "小夜/SAYO",
      "a": 58.6,
      "e": 61.69,
      "t": "地面がぶるぶるしたから、ツチブルイ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 62.14,
      "e": 65.07,
      "t": "湧き水が泥だらけだ。ぼくがかき出す。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 65.52,
      "e": 70.21,
      "t": "おれも行くぞ。水がすむまでは、シミアナと大川の上手からくむ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 71.41,
      "e": 73.55,
      "t": "秋・炉のそば"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 74.15,
      "e": 81.38,
      "t": "ツル、手を見せておくれ。……あったかい手だね。もう、わたしの手はいらないよ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 81.83,
      "e": 86.96,
      "t": "シイばあ、そんなこと言わないで。ユゲグサ、また煮るから。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 87.41,
      "e": 92.58,
      "t": "ナギ、足は冷えていないかい。浜の冬は寒いからね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 93.03,
      "e": 96.34,
      "t": "冷えていない。……シイ、少し眠るといい。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 96.79,
      "e": 103.73,
      "t": "そうするよ。わたしのあとは、寄り合いで、みんながうなずく人を選んでおくれ。"
    },
    {
      "k": "s",
      "s": 3,
      "a": 104.93,
      "e": 107.83,
      "t": "冬・ネムリアナと小石"
    },
    {
      "k": "l",
      "s": 3,
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 108.43,
      "e": 116.29,
      "t": "かご一つに、小石一つ。小石がテノカズで、オオイシ一つ。……オオイシが四つと、小石が四つ。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 116.74,
      "e": 117.87,
      "t": "ぼくも、やる。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 118.32,
      "e": 121.23,
      "t": "その小石は、いつもにぎっている石か。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "満別花丸",
      "a": 121.68,
      "e": 124.08,
      "t": "これ、ぼくの。……数える石にする。"
    },
    {
      "k": "l",
      "s": 3,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 124.53,
      "e": 130.31,
      "t": "なら、毎日いっしょに数える。かごを一つ食べたら、小石を一つ動かす。"
    },
    {
      "k": "m",
      "a": 131.51,
      "e": 134.16,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 134.76,
      "e": 140.39,
      "t": "シイは最後に、寄り合いで、みんながうなずく人を選んでおくれ、と言った。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 140.84,
      "e": 145.31,
      "t": "長老って、いちばん年が上の人がなるの？ なんで？"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 145.76,
      "e": 153.34,
      "t": "年が上なのは、おれだ。だが、おれは考えるより先に体が動く。決めるのは、ナギがいい。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 153.79,
      "e": 165.47,
      "t": "たとえば、長老がいなくなったら、寄り合いで一人ずつ話して、みんながうなずいた人を次の長老にしよう。それなら、川上から来たわたしも、心からうなずけます。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 165.92,
      "e": 172.19,
      "t": "まあまあ、それなら、わたしはナギにうなずくよ。かあさんも、きっと笑ってる。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 172.64,
      "e": 177.58,
      "t": "シミアナの水で、浜の冬を越せたんだ。ソヨもオキも、元気だったよ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 178.03,
      "e": 184.23,
      "t": "蓄えは、小石が五つ残った。春は、浜の貝と海草を多めにとって食べる。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 184.68,
      "e": 192.97,
      "t": "わたしは、シイかあさんとトチとうちゃんの眠る所で、みんなが毎年、思い出して笑えますように、って願いたい。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 193.42,
      "e": 198.67,
      "t": "ぼくは、湿地の草の種が、もっと見つかりますように、って思う。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 199.12,
      "e": 216.03,
      "t": "決める。次の長老は、みんながうなずいて決める。みんながうなずいたので、わたしが長老を引きうける。春は浜の物を多めにとる。天に届けるのは、アケビの、シイとトチの眠る所でみんなが毎年笑えるようにという願いにする。"
    }
  ]
}