  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 2.94,
      "t": "5年目　ヒカリオノの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 3.84,
      "e": 5.9,
      "t": "春・トギイシ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 6.5,
      "e": 10.66,
      "t": "じいちゃん、一日こすっても、ちょっとしか光らないよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 11.11,
      "e": 16.99,
      "t": "石は、急かしても変わらん。水と砂と、日の数じゃ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 17.44,
      "e": 19.88,
      "t": "そんなことで、太い木が切れるのか。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 20.33,
      "e": 28.47,
      "t": "割った刃は欠ける。こすった刃は、欠けん。……わしの手でも、こするだけならできる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 28.92,
      "e": 32.16,
      "t": "じゃあ、ぼくが割って、じいちゃんがこする！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 32.61,
      "e": 37.86,
      "t": "この平たい石は、トギイシと呼ぶ。刃をとぐ石じゃ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 39.06,
      "e": 41.62,
      "t": "夏・大風の夜"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 42.22,
      "e": 48.38,
      "t": "イソ、ゆうべ寝ながら「ウル、ウル」って言ってたよ。なんで？"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 48.83,
      "e": 49.87,
      "t": "……聞こえちゃったかあ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 50.32,
      "e": 56.76,
      "t": "ときどき夢を見るんだ。大きな水と、浮かぶ木と、だれかが「ウル」って呼ぶ声。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 57.21,
      "e": 60.59,
      "t": "流れ着いた朝も、おまえはその言葉を言っていた。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 61.04,
      "e": 66.43,
      "t": "たとえば、ウルは浮かぶ木を呼ぶ言葉なのかもしれない。イソが来た所の言葉で。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 66.88,
      "e": 72.01,
      "t": "浜の流木も、ゆうべの風に負けずに浮かんでた。あれが、ぼくのウルかなあ。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 73.21,
      "e": 75.74,
      "t": "秋・ケヤキの柱"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 76.34,
      "e": 79.36,
      "t": "見ろ。刃が木に食いこんだ。欠けてもいない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 79.81,
      "e": 86.0,
      "t": "柄は、もっと強くしばろう。たとえば、縄を二重に巻いて、かわかした皮でおさえる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 86.45,
      "e": 91.53,
      "t": "このケヤキは実をくれないし、大風で倒れた木だよ。掟にもふれない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 91.98,
      "e": 95.5,
      "t": "ああ。……ヨシ、この柄、いい。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 95.95,
      "e": 98.33,
      "t": "……カシに言われると、くすぐったいな。"
    },
    {
      "k": "m",
      "a": 99.53,
      "e": 102.19,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 102.79,
      "e": 107.41,
      "t": "ヒカリオノはいい。だが一つでは足りん。みがく者を増やせ。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 107.86,
      "e": 114.19,
      "t": "ぼく、割るのも、こするのも、もうできるよ！ もっと早くみがけるようになりたい！"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 114.64,
      "e": 119.98,
      "t": "……わたしにも、石のこすり方を教えてほしい。縄をなう合間に、こすれる。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 120.43,
      "e": 125.78,
      "t": "……ヨシの手は確かじゃ。よかろう。コナと二人でこすれ。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 126.23,
      "e": 131.68,
      "t": "大風の夜、ホリヤは揺れなかった。大きいのができれば、みんな入れる。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 132.13,
      "e": 140.13,
      "t": "春に大きなホリヤを建てるなら、それまでは、寒さに弱い者からホリヤに寝るのを続けておくれ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 140.58,
      "e": 147.69,
      "t": "ぼくの夢の話、みんな笑わないで聞いてくれた。……願いは、浮かぶ木の中をくり抜いて、乗れるようにしたい。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 148.14,
      "e": 152.04,
      "t": "ヒカリオノは一つだ。それより、大きなホリヤが先だ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 152.49,
      "e": 157.78,
      "t": "まあまあ。おのは家に使って、浮かぶ木のことは天に頼めばいいじゃない。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 158.23,
      "e": 171.2,
      "t": "決める。ヨシもトギイシを習え。春にはケヤキの柱で、大きなホリヤを建てる。それまで、ホリヤは寒さに弱い者からじゃ。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 171.65,
      "e": 177.34,
      "t": "おのは家に使う。だから、今年の願いはイソのにする。"
    }
  ]
}