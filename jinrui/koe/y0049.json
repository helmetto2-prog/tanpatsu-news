{
  "schema": 1,
  "year": 49,
  "title": "49年目　スエグツの年",
  "src": "y0049.mp3",
  "dur": 231.09,
  "hash": "c661fa58ebe4bc83c65fad06",
  "made": "2026-11-28 00:50",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.77,
      "t": "49年目　スエグツの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.67,
      "e": 7.81,
      "t": "夏・ナカビの年寄りたち"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 8.41,
      "e": 15.23,
      "t": "コナ、あの杖の人が、いちばん年かさの年寄りだよ。とうちゃんの名を、最初に呼んでくれた人。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 15.68,
      "e": 20.51,
      "t": "……ぼくも年寄りの仲間だ。年寄りどうし、同じ火に座ればいい。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 20.96,
      "e": 28.01,
      "t": "見て、年寄りの人が、ナワメのグツの筋を指でなぞってる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 28.46,
      "e": 34.98,
      "t": "「この筋は、ヨシの縄のより方だ」って言ってる。とうちゃんの縄だって、分かったんだね！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 35.43,
      "e": 41.77,
      "t": "クリ、伝えてくれ。遠い道を来てくれてありがとう、と。ナエウタの言葉で。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 42.22,
      "e": 47.02,
      "t": "うん。じゃあ、ナエウタの続きを、みんなで歌おう！"
    },
    {
      "k": "s",
      "s": 1,
      "a": 48.22,
      "e": 50.82,
      "t": "秋・ツチブルイの夜"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 51.42,
      "e": 57.59,
      "t": "ツチブルイだ！ みんな、ホリヤの外へ。柱の下にいないで！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 58.04,
      "e": 61.42,
      "t": "火は、ぼくが見る。炉の火、消えてない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 61.87,
      "e": 68.15,
      "t": "グツが……棚の大きいグツが、二つとも割れちゃった。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 68.6,
      "e": 73.32,
      "t": "森のナリナワが鳴ってる。でも、イノシシじゃない。森も、ゆれたんだ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 73.77,
      "e": 78.1,
      "t": "けがした人はいない？ ……よかった、みんないる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 78.55,
      "e": 87.48,
      "t": "高い棚に置くから落ちるんだ。グツを地面に据えれば、ゆれても倒れないかもしれない。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 88.68,
      "e": 91.05,
      "t": "冬・ミルのホリヤ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 91.65,
      "e": 100.46,
      "t": "グツの番は、わたしがする。だから、グツのそばに自分のホリヤを掘りたい。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 100.91,
      "e": 107.31,
      "t": "ミルが一人で住むの？ ……さみしくなるけど、となりだもんね。毎朝、声をかけるよ！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 107.76,
      "e": 111.66,
      "t": "土は、ぼくが運ぶ。浜の流木を集めるのと同じだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 112.11,
      "e": 121.29,
      "t": "床のはしに丸い穴を掘って、グツを首まで埋めるの。据えたグツだから、スエグツ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 121.74,
      "e": 125.53,
      "t": "ミルのホリヤができたら、青い小石も、ここに置いていい？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 125.98,
      "e": 131.82,
      "t": "……うん。青い小石は、いちばんいいグツに入れておく。"
    },
    {
      "k": "m",
      "a": 133.02,
      "e": 135.67,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 136.27,
      "e": 142.86,
      "t": "蓄え、八十九かご。カチガイを一かご、年寄りたちにおくった。冬は越せる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 143.31,
      "e": 160.6,
      "t": "ツチブルイで、棚のグツが二つ割れた。大きいグツは、床に掘った穴に据えておきたい。わたしのホリヤのスエグツは、冬のツチブルイでも倒れなかった。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 161.05,
      "e": 166.18,
      "t": "……アカガケの道も埋まった。トオミイワへは、しばらく登らない方がいい。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p11",
      "n": "クリ",
      "v": "四国めたん",
      "a": 166.63,
      "e": 172.47,
      "t": "年寄りたちは、また水の低い夏に来たいって。次は、こっちの丘も見せたいな！"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 172.92,
      "e": 181.75,
      "t": "ヌクシオは、南の風の三日あとに、二度とも来た。ツキキザミのしるしは、そろったよ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p15",
      "n": "オキ",
      "v": "猫使アル",
      "a": 182.2,
      "e": 193.24,
      "t": "なら、来年の夏、ヌクシオの日にオオウルで南へ出たい。クロミネの峰が見えなくなる前に引き返す。ぼくの願いは、ヌクシオの来る方の浜が見えますように、だ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p16",
      "n": "ナツ",
      "v": "栗田まろん",
      "a": 193.69,
      "e": 199.68,
      "t": "ぼくもオキと乗る。……それと、カタミのからが楽に割れたらいいのに。毎冬、手が痛くなる。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 200.13,
      "e": 206.03,
      "t": "海へ出る日は、ハナでけむりを上げようね。帰る日も、ちゃんとしるして！"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 206.48,
      "e": 230.09,
      "t": "……では決める。大きいグツは、床に掘った穴に据えて置く。トオミイワへは、くずれた道を見なおすまで登らない。来年の夏、ヌクシオの日に、オキとナツとソヨがオオウルで南へ出て、クロミネの峰が見えなくなる前に引き返す。天に届けるのは、ヌクシオの来る方の浜が見えますようにという、オキの願いにする。"
    }
  ]
}