  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 4.59,
      "t": "39年目　大風と赤い土の年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 5.49,
      "e": 8.26,
      "t": "春・黄色い土を焼く"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 8.86,
      "e": 19.89,
      "t": "コナ、見て。アカガケの下の黄色い土を、グツに入れて火にかけたら、こんなに赤くなったよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 20.34,
      "e": 25.51,
      "t": "ほんとだ、ヒイシの粉とおんなじ色だ。雷の落ちた跡と同じだね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 25.96,
      "e": 30.36,
      "t": "まあ、焼いたら色が変わるなんて、グツの土とおんなじだねえ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 30.81,
      "e": 37.36,
      "t": "これなら、アカガケの赤い小石を、たくさん取らなくてもいい。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 37.81,
      "e": 43.41,
      "t": "黄色い土も、掟のとおり、二人で行って、かご一つまでにしよう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 43.86,
      "e": 49.5,
      "t": "うん。焼いて赤くするから、アカヤキって呼ぶね。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 50.7,
      "e": 53.61,
      "t": "夏・大風の前の日"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 54.21,
      "e": 59.05,
      "t": "とうちゃん、海が低くうなってる。空も黄色い。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 59.5,
      "e": 64.65,
      "t": "こんな空は、カシじいがいたころに、一度見たきりかなあ。大風が来るよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 65.1,
      "e": 68.15,
      "t": "ウルを、丘のふもとまで上げよう！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 68.6,
      "e": 70.67,
      "t": "縄、ある。しばる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 71.12,
      "e": 77.43,
      "t": "コイシ、そっちの根っこに回して！ ……すごい、ぜんぜん動かない。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 77.88,
      "e": 80.42,
      "t": "三本より合わせの縄。切れない。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 81.62,
      "e": 84.54,
      "t": "秋・物置の子ダヌキ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 85.14,
      "e": 88.95,
      "t": "かあちゃん、見て！ 物置のすみに、ぬれた子ダヌキがいる。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 89.4,
      "e": 93.48,
      "t": "うしろ足を引きずってるね。ヒヤシバで包んであげよう。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 93.93,
      "e": 98.54,
      "t": "なんで物置に？ ……そうか、大風で森の巣がつぶれたんだね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 98.99,
      "e": 102.4,
      "t": "ぼく、自分の干し魚を分けてあげる。いい？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 102.85,
      "e": 109.38,
      "t": "いいよ。でも、足が治ったら森へ帰すんだよ。ここは、タヌキの家じゃないからね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 109.83,
      "e": 112.11,
      "t": "うん。治ったら、ちゃんと帰す。"
    },
    {
      "k": "m",
      "a": 113.31,
      "e": 115.96,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p13",
      "n": "コイシ",
      "v": "剣崎雌雄",
      "a": 116.56,
      "e": 123.96,
      "t": "数えた。小石、去年よりずっと少ない。でも、前の蓄えがある。冬は、こせる。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 124.41,
      "e": 129.71,
      "t": "大風の夜、ウルを丘のふもとまで上げていなかったら、二そうとも流されていたかなあ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 130.16,
      "e": 136.69,
      "t": "これからは、大風の来そうな日には、ウルを丘のふもとへ上げて、縄で木の根にしばることにしようよ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 137.14,
      "e": 144.24,
      "t": "なんで丘のふもとまで？ ……そうか、浜の小屋の屋根まで飛んだんだものね。わたしもそれがいいと思う。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p12",
      "n": "ミル",
      "v": "九州そら",
      "a": 144.69,
      "e": 156.23,
      "t": "赤い色は、アカガケの下の黄色い土を焼いたアカヤキで作れる。ヒイシの赤い小石は、とっておけるよ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p16",
      "n": "ナツ",
      "v": "猫使アル",
      "a": 156.68,
      "e": 161.6,
      "t": "子ダヌキ、雪の朝に森へ帰ったよ。足、ちゃんと治ってた。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 162.05,
      "e": 171.5,
      "t": "大風の前の空の色と海の音を、小石で並べて覚えてるの。でも、まだ前の日にしか分からない。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p14",
      "n": "ソヨ",
      "v": "中国うさぎ",
      "a": 171.95,
      "e": 178.77,
      "t": "大風の来る日が、もっと前から分かれば、クリの実が落ちる前に拾えるのに。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 179.22,
      "e": 194.26,
      "t": "では決める。大風の来そうな日には、ウルを丘のふもとへ上げてしばる。赤い色は、なるべくアカヤキで作る。天に届けるのは、大風の来る日が前もって分かるようにという、ソヨの願いにする。"
    }
  ]
}