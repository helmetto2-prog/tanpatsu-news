  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 2.78,
      "t": "6年目　ウルの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 3.68,
      "e": 5.82,
      "t": "春・火を浜へ"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 6.42,
      "e": 11.53,
      "t": "じい、炉の火を少し分けてほしいんだ。浜で、浮かぶ木を焦がしてみたい。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 11.98,
      "e": 15.99,
      "t": "炉の火は絶やさんのが掟だ。浜へ持っていって消したらどうする。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 16.44,
      "e": 24.91,
      "t": "丘の火を消すわけじゃないよ。燃えさしを分けるだけさ。ただ、イソ、夜はちゃんと眠るんだよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 25.36,
      "e": 33.88,
      "t": "丘の火は丘で守る。浜の火は、浜の者が守れ。消えたら、また分けに来い。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 34.33,
      "e": 38.43,
      "t": "うん。消さないように、焦がしすぎないように、見てるよ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 39.63,
      "e": 42.21,
      "t": "夏・大漁の朝"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 42.81,
      "e": 45.84,
      "t": "潮が満ちる。群れが来る。今だ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p09",
      "n": "コナ",
      "v": "白上虎太郎",
      "a": 46.29,
      "e": 48.9,
      "t": "見て見て！ 水が魚で光ってる！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 49.35,
      "e": 51.94,
      "t": "かごの目から、どんどんこぼれてくよ！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 52.39,
      "e": 56.36,
      "t": "浜の火で干そう。けむりなら、焦がしてる火がずっと燃えてる。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 56.81,
      "e": 62.03,
      "t": "いい。とれた分は、みんな干す。こぼれた分は……しかたない。"
    },
    {
      "k": "s",
      "s": 2,
      "a": 63.23,
      "e": 65.54,
      "t": "秋・ウルが浮かぶ"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 66.14,
      "e": 70.34,
      "t": "ホムラ、いっしょに乗ってみない？ 最初は、ホムラがいいんだ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 70.79,
      "e": 72.51,
      "t": "なんで、わたし？"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 72.96,
      "e": 77.97,
      "t": "うーん……なんでかなあ。ホムラなら、ひっくり返っても笑ってくれそうだから。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 78.42,
      "e": 80.07,
      "t": "笑わないよ。……乗る。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 80.52,
      "e": 83.67,
      "t": "浅瀬だけだ。潮が引く前に、もどれ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 84.12,
      "e": 88.56,
      "t": "浮いた！ 二人でも、沈まない。これが、ぼくのウルだ。"
    },
    {
      "k": "m",
      "a": 89.76,
      "e": 92.42,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 93.02,
      "e": 103.17,
      "t": "大きなホリヤができて、みんな冷えずに眠れるようになったよ。寒さに弱い者から、という決まりは、もういらないね。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 103.62,
      "e": 109.29,
      "t": "浜の火を一人で守ると、眠る。ウルが焦げすぎかけた。番は二人だ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 109.74,
      "e": 116.4,
      "t": "丘の火は丘の番が守る。浜で火を燃やすときは、二人で番をしておくれ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 116.85,
      "e": 119.83,
      "t": "ウルで、入り江の向こうの島まで行ってみたいなあ。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 120.28,
      "e": 122.28,
      "t": "まだ早い。浅瀬だけだ。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 122.73,
      "e": 130.45,
      "t": "なんで？……ううん、分かってる。波の高い所でひっくり返ったら、だれも助けに行けないから。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 130.9,
      "e": 139.43,
      "t": "大漁の日、魚がかごの目からこぼれた。半分は逃げた。群れで来た魚を、一度にたくさんすくえる物がほしい。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 139.88,
      "e": 146.36,
      "t": "……たとえば、クモの巣のように縄を結んだ物なら。前に一度試して、破れてしまったけれど。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 146.81,
      "e": 153.58,
      "t": "まあまあ、ミルが大きくなるころには、魚もたくさん食べさせたいね。ナギの願いにしようよ。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 154.03,
      "e": 165.91,
      "t": "決める。寒さに弱い者からの掟は、やめる。浜で火を燃やすときは、番を二人でせい。ウルは浅瀬までじゃ。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 166.36,
      "e": 170.35,
      "t": "天に届けるのは、ナギの願いにする。"
    }
  ]
}