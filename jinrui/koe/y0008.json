{
  "schema": 1,
  "year": 8,
  "title": "8年目　グツの年",
  "src": "y0008.mp3",
  "dur": 186.84,
  "hash": "582fefc76494de918e08ad52",
  "made": "2026-10-23 15:20",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 2.76,
      "t": "8年目　グツの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 3.66,
      "e": 5.75,
      "t": "春・土の鳥"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 6.35,
      "e": 12.51,
      "t": "母さん、見て！ 灰の中から、むかしわたしがこねた土の鳥が出てきたよ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 12.96,
      "e": 20.16,
      "t": "まあ、まだ形が残っていたのかい。灰で手が冷えないように、よく拭いておくれ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 20.61,
      "e": 25.19,
      "t": "湧き水に入れても、溶けないよ。背中に水がたまってる！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 25.64,
      "e": 32.59,
      "t": "ねえ、この土で、鳥じゃなくて大きなくぼみを作ったら……水も実も入れられるんじゃない？"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 33.04,
      "e": 40.97,
      "t": "火のそばに置いたら固くなったんだね。やってごらん。ただし、やけどだけはしないでおくれ。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 42.17,
      "e": 45.43,
      "t": "夏・ひとつだけ残った器"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 46.03,
      "e": 52.11,
      "t": "割れた物を見ると、厚い所から割れています。たとえば、もっと同じ厚さにしたら……。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 52.56,
      "e": 57.09,
      "t": "まあまあ、一つは残ったんだもの。ほら、ひびもないよ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 57.54,
      "e": 61.83,
      "t": "数えた。こねたのはテノカズと三つ。残ったのは一つ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 62.28,
      "e": 64.94,
      "t": "この一つで、カシの実を煮てみよう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 65.39,
      "e": 69.03,
      "t": "ぐつぐつ言ってる！ ぐつぐつ言うから……グツ！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 69.48,
      "e": 76.25,
      "t": "グツ、いい名前。……あ、しぶくない。しぶいのが、お湯に逃げてった！"
    },
    {
      "k": "l",
      "s": 1,
      "j": 6,
      "p": "p10",
      "n": "ツル",
      "v": "東北ずん子",
      "a": 76.7,
      "e": 80.5,
      "t": "シブニゲと同じだね。でも、ずっと早い！"
    },
    {
      "k": "s",
      "s": 2,
      "a": 81.7,
      "e": 84.53,
      "t": "冬・雪の降らない冬"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 85.13,
      "e": 88.25,
      "t": "掟だ。雪が降るまで、穴は開けない。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 88.7,
      "e": 93.67,
      "t": "雪は来ない。北の山は、もう白い。待てば子どもが弱る。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 94.12,
      "e": 100.46,
      "t": "子どもたちのおなかが、夜ごと鳴っているよ。冷えた体で眠らせたくないね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 100.91,
      "e": 103.15,
      "t": "……母さんが決めるなら、従う。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 103.6,
      "e": 109.32,
      "t": "開けよう。ナギ、オオイシで数えて、少しずつ分けておくれ。"
    },
    {
      "k": "m",
      "a": 110.52,
      "e": 113.18,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 113.78,
      "e": 121.37,
      "t": "雪が降るまで、と決めたのはわたしだ。けれど、この丘には雪の降らない冬もある。決め方を変えたい。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 121.82,
      "e": 128.25,
      "t": "北の山が白くなったら開ける。開けるときは、わたしがオオイシで数える。これでどうだ。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 128.7,
      "e": 132.94,
      "t": "山が白いかどうかは、だれが見ても分かる。それならいい。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 133.39,
      "e": 140.26,
      "t": "グツがあれば、しぶい実もその日に食べられるよ。もっと作りたいけど、焼くとほとんど割れちゃうの。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 140.71,
      "e": 146.48,
      "t": "割れ方を見て、小さく試してみます。厚さを変えたり、乾かし方を変えたり。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 146.93,
      "e": 156.24,
      "t": "けれど、一人で試していては何年もかかります。焼いても割れない土の器を、たくさん作れるようにしたい。天に頼むなら、それです。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 156.69,
      "e": 162.92,
      "t": "わたしは、よその人に会いたい。あの人たちなら、割れない器のことも知ってるかもしれない。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 163.37,
      "e": 167.16,
      "t": "川上へは、こちらから行かない。去年決めたことだ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 167.61,
      "e": 179.25,
      "t": "決めるよ。掟「秋の蓄えは雪が降るまで開けない」はやめて、ナギの言うとおり、北の山が白くなったら開けることにする。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 179.7,
      "e": 185.84,
      "t": "グツは、アケビとヨシで作っておくれ。願いは、ヨシのにしよう。"
    }
  ]
}