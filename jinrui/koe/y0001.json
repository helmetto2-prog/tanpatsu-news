{
  "schema": 1,
  "year": 1,
  "title": "1年目　ナツユキの年",
  "src": "y0001.mp3",
  "dur": 239.96,
  "hash": "c12c8d61d1210e0ad0d2812c",
  "made": "2026-10-23 15:17",
  "narrator": "No.7",
  "items": [
    {
      "k": "t",
      "a": 0.0,
      "e": 3.11,
      "t": "1年目　ナツユキの年"
    },
    {
      "k": "s",
      "s": 0,
      "a": 4.01,
      "e": 6.41,
      "t": "夏・夏の雪"
    },
    {
      "k": "l",
      "s": 0,
      "j": 0,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 7.01,
      "e": 10.87,
      "t": "父さん！ 森の奥に、夏なのに雪が積もってる！"
    },
    {
      "k": "l",
      "s": 0,
      "j": 1,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 11.32,
      "e": 14.82,
      "t": "一人で森の奥まで行ったのか。危ないと言っただろう。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 2,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 15.27,
      "e": 21.56,
      "t": "なんで？ 入り口の木に登って見ただけだよ。それに、わたしの足ならすぐ逃げられる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 3,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 22.01,
      "e": 25.34,
      "t": "雪じゃない。風が甘い。……花のにおいだね。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 4,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 25.79,
      "e": 33.32,
      "t": "白い花に甘いにおい……クリの花じゃ。秋になれば、実がヤマホド落ちる。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 5,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 33.77,
      "e": 37.3,
      "t": "よし、行くぞ。ホムラ、道を教えろ。"
    },
    {
      "k": "l",
      "s": 0,
      "j": 6,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 37.75,
      "e": 42.01,
      "t": "うん！ ついてきて。先に行くのは、わたしだからね。"
    },
    {
      "k": "s",
      "s": 1,
      "a": 43.21,
      "e": 45.63,
      "t": "秋・冷たい穴"
    },
    {
      "k": "l",
      "s": 1,
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 46.23,
      "e": 53.55,
      "t": "夏に湧き水のそばの穴へ入れた貝、夕方まで冷たいままだった。木の実も、穴に入れたらどうだろう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 1,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 54.0,
      "e": 61.68,
      "t": "たとえば、底に木の葉を敷いて、ふたをすれば、ネズミも入れない。まず一かごだけ、小さく試してみよう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 62.13,
      "e": 66.77,
      "t": "一かごずつ試していたら、冬が来てしまう。掘るなら大きく掘るぞ。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 3,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 67.22,
      "e": 74.71,
      "t": "まあまあ。兄さんが大きく掘って、ヨシがふたを作ればいいじゃない。二人とも、得意なことをしよう。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 4,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 75.16,
      "e": 79.14,
      "t": "穴は三つ。一つに、テノカズのかごが入るくらい。"
    },
    {
      "k": "l",
      "s": 1,
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北きりたん",
      "a": 79.59,
      "e": 82.87,
      "t": "木の実が、ねんねする穴だね。ネムリアナ！"
    },
    {
      "k": "s",
      "s": 2,
      "a": 84.07,
      "e": 86.99,
      "t": "秋・名前をつけた夜"
    },
    {
      "k": "l",
      "s": 2,
      "j": 0,
      "p": "p02",
      "n": "シイ",
      "v": "東北イタコ",
      "a": 87.59,
      "e": 94.68,
      "t": "よく生まれてきたねえ。アケビ、まずはお乳だよ。体を冷やさないようにね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 1,
      "p": "p10",
      "n": "ツル",
      "v": "東北きりたん",
      "a": 95.13,
      "e": 97.08,
      "t": "ちっちゃい！ クリの実みたい！"
    },
    {
      "k": "l",
      "s": 2,
      "j": 2,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 97.53,
      "e": 102.25,
      "t": "ふふ、ほんとだ。クリの実が最後に落ちた日に生まれたもんね。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 3,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 102.7,
      "e": 110.86,
      "t": "わしはトチ、ばあさんはシイ。カシにコナ。木の実の名をもらった子は、よく育つ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 111.31,
      "e": 114.85,
      "t": "……クリ。いい名前だね。ツルが見つけてくれた名だ。"
    },
    {
      "k": "l",
      "s": 2,
      "j": 5,
      "p": "p10",
      "n": "ツル",
      "v": "東北きりたん",
      "a": 115.3,
      "e": 117.23,
      "t": "ツル、お姉ちゃんになった！"
    },
    {
      "k": "m",
      "a": 118.43,
      "e": 121.08,
      "t": "年の終わりの寄り合い"
    },
    {
      "k": "ml",
      "j": 0,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 121.68,
      "e": 134.77,
      "t": "数えた。秋にためたかごは、オオイシ四つと小石五つ。冬に食べたのは、オオイシ三つと小石三つ。残りはオオイシ一つと小石二つ。おなかを鳴らした子は、いない。"
    },
    {
      "k": "ml",
      "j": 1,
      "p": "p04",
      "n": "ナギ",
      "v": "波音リツ",
      "a": 135.22,
      "e": 145.28,
      "t": "秋にためた物は、雪が降るまで開けない。来年の秋も、ネムリアナを掘る。そう決めておきたい。早く食べると、去年と同じになる。"
    },
    {
      "k": "ml",
      "j": 2,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 145.73,
      "e": 149.61,
      "t": "それがいい。腹がへってから慌てるのは、もうごめんだ。"
    },
    {
      "k": "ml",
      "j": 3,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 150.06,
      "e": 155.63,
      "t": "ナツユキの森のクリの木は、だれも切らないことにして。あの木が実をくれたんだから。"
    },
    {
      "k": "ml",
      "j": 4,
      "p": "p05",
      "n": "ヨシ",
      "v": "雀松朱司",
      "a": 156.08,
      "e": 162.2,
      "t": "たとえば、木を切ってしまえば、次の秋は実が落ちない。木を残すのは筋が通っている。"
    },
    {
      "k": "ml",
      "j": 5,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 162.65,
      "e": 171.14,
      "t": "それと、もう一つ。なんで大きな獣の狩りは、大人の男だけなの？ あの森を見つけたのは、わたしだよ。"
    },
    {
      "k": "ml",
      "j": 6,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 171.59,
      "e": 178.63,
      "t": "イノシシは、やりが届く所まで近づかないと倒せない。牙にかかったら、足が速くても逃げきれん。"
    },
    {
      "k": "ml",
      "j": 7,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 179.08,
      "e": 183.7,
      "t": "まあまあ。……でも、ホムラの目がいいのは、みんな知ってるよ。"
    },
    {
      "k": "ml",
      "j": 8,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 184.15,
      "e": 195.44,
      "t": "決める。秋の蓄えは、雪が降るまで開けん。実をくれる木は、切らん。狩りの掟は、むかしのままじゃ。"
    },
    {
      "k": "ml",
      "j": 9,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 195.89,
      "e": 208.01,
      "t": "じゃが、ホムラ。来年の秋までに、獣の足あとをテノカズ読み分けてみせい。そうしたら、もう一度ここで話そう。"
    },
    {
      "k": "ml",
      "j": 10,
      "p": "p07",
      "n": "ホムラ",
      "v": "春日部つむぎ",
      "a": 208.46,
      "e": 212.19,
      "t": "……わかった。テノカズでも、ヤマホドでも読んでみせる。"
    },
    {
      "k": "ml",
      "j": 11,
      "p": "p06",
      "n": "アケビ",
      "v": "もち子さん",
      "a": 212.64,
      "e": 219.53,
      "t": "それから、願いのこと。穴の底のしぶいカシの実を、子どもたちがおいしく食べられたらいいなって。"
    },
    {
      "k": "ml",
      "j": 12,
      "p": "p03",
      "n": "カシ",
      "v": "青山龍星",
      "a": 219.98,
      "e": 223.0,
      "t": "おれは、やりより遠くまで届く物がほしい。"
    },
    {
      "k": "ml",
      "j": 13,
      "p": "p08",
      "n": "イソ",
      "v": "玄野武宏",
      "a": 223.45,
      "e": 227.68,
      "t": "海の向こうってさ……入り江の向こうへ、いつか行ってみたいなあ。"
    },
    {
      "k": "ml",
      "j": 14,
      "p": "p01",
      "n": "トチ",
      "v": "ちび式じい",
      "a": 228.13,
      "e": 238.96,
      "t": "イソの「入り江の向こう」も聞いた。じゃが、冬の命は木の実じゃ。今年の願いは、アケビのにする。"
    }
  ]
}